                <div id="cart-subtotal" class="mt-4 fw-bold fs-5 text-dark"></div>
                <div class="mt-4">
                    <a href="/cart" class="btn btn-dark w-100 mb-2">Go to Cart</a>
                    <button id="continue-browsing" class="btn btn-outline-secondary w-100">Continue Browsing</button>
                </div>
            </div>

            <!-- Overlay -->
            <div id="cart-overlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1040;"></div>
        </t>
    </xpath>

    <!-- FIXED CART JAVASCRIPT (Now also updates mobile icon) -->
    <xpath expr="." position="inside">
        <script type="text/javascript">
        <![CDATA[
        document.addEventListener('DOMContentLoaded', function () {
            const openCartLink = document.getElementById('openCartLink');
            const openCartLinkMobile = document.getElementById('openCartLinkMobile');
            const cartDrawer = document.getElementById('cart-drawer');
            const cartOverlay = document.getElementById('cart-overlay');
            const closeCart = document.getElementById('close-cart');
            const continueBrowsing = document.getElementById('continue-browsing');
            const cartCount = document.getElementById('cart-count');
            const cartCountMobile = document.getElementById('cart-count-mobile');
            const drawerItemCount = document.getElementById('drawer-item-count');

            // Open cart (both desktop and mobile)
            function openCartDrawer(e) {
                e.preventDefault();
                cartDrawer.style.display = 'block';
                cartOverlay.style.display = 'block';
                renderCart();
            }
            if (openCartLink) openCartLink.addEventListener('click', openCartDrawer);
            if (openCartLinkMobile) openCartLinkMobile.addEventListener('click', openCartDrawer);

            // Close cart
            function closeCartDrawer() {
                cartDrawer.style.display = 'none';
                cartOverlay.style.display = 'none';
            }
            closeCart.addEventListener('click', closeCartDrawer);
            continueBrowsing.addEventListener('click', closeCartDrawer);
            cartOverlay.addEventListener('click', closeCartDrawer);

            // Update cart count (both desktop text and mobile badge)
            function updateCartCount() {
                const cart = JSON.parse(localStorage.getItem('cart') || '[]');
                const total = cart.reduce((sum, item) => sum + item.qty, 0);

                // Desktop: My cart (3)
                if (cartCount) {
                    cartCount.textContent = total > 0 ? `(${total})` : '';
                }

                // Mobile badge
                if (cartCountMobile) {
                    cartCountMobile.textContent = total;
                    cartCountMobile.style.display = total > 0 ? 'block' : 'none';
                }

                if (drawerItemCount) drawerItemCount.textContent = total;
            }

            // Render cart items
            function renderCart() {
                const cart = JSON.parse(localStorage.getItem('cart') || '[]');
                const itemsContainer = document.getElementById('cart-items');
                let html = '';
                let subtotal = 0;

                if (cart.length === 0) {
                    html = '<p class="text-center text-muted my-5">Your cart is empty</p>';
                } else {
                    cart.forEach((item, index) => {
                        subtotal += item.price * item.qty;
                        html += `
                            <div style="display:flex; gap:15px; padding:15px 0; border-bottom:1px solid #eee; align-items:start;">
                                <img src="${item.image || '/insabhi_custom_website/static/src/img/placeholder.jpg'}"
                                     alt="${item.name || 'Product'}"
                                     style="width:80px; height:80px; object-fit:cover; border-radius:8px; background:#f0f0f0;">
                                <div style="flex:1;">
                                    <h6 class="mb-1">${item.name || 'Unknown Product'}</h6>
                                    <p class="mb-2 text-muted">${item.price ? item.price.toFixed(2) : '0.00'} KWD</p>
                                    <div style="display:flex; align-items:center; gap:10px;">
                                        <button onclick="window.updateQty(${index}, -1)"
                                                style="width:32px; height:32px; border:1px solid #ddd; background:#fff; border-radius:6px; font-weight:bold;">-</button>
                                        <span style="min-width:30px; text-align:center; font-weight:600;">${item.qty}</span>
                                        <button onclick="window.updateQty(${index}, 1)"
                                                style="width:32px; height:32px; border:1px solid #ddd; background:#fff; border-radius:6px; font-weight:bold;">+</button>
                                    </div>
                                </div>
                                <button onclick="window.removeFromCart(${index})"
                                        style="background:none; border:none; color:#999; font-size:1.2rem; margin-top:5px;">×</button>
                            </div>`;
                    });
                }

                itemsContainer.innerHTML = html;
                document.getElementById('cart-subtotal').textContent = `Subtotal: ${subtotal.toFixed(2)} KWD`;
            }

            // Update quantity
            window.updateQty = function (index, change) {
                let cart = JSON.parse(localStorage.getItem('cart') || '[]');
                cart[index].qty += change;
                if (cart[index].qty <= 0) cart.splice(index, 1);
                localStorage.setItem('cart', JSON.stringify(cart));
                updateCartCount();
                renderCart();
            };

            // Remove item
            window.removeFromCart = function (index) {
                let cart = JSON.parse(localStorage.getItem('cart') || '[]');
                cart.splice(index, 1);
                localStorage.setItem('cart', JSON.stringify(cart));
                updateCartCount();
                renderCart();
            };

            // Global functions
            window.updateCartCount = updateCartCount;
            window.renderCart = renderCart;

            // Initial load
            updateCartCount();
        });
        ]]>
        </script>
    </xpath>
</template>
