                                                     alt="Instagram" width="28" height="28" style="filter: brightness(0) invert(1);"/>
                                                <span style="font-size:13px; margin-top: 4px;">Instagram</span>
                                            </a>

                                            <!-- X -->
                                            <a href="https://x.com/tenspakw" target="_blank"
                                               class="text-white text-decoration-none d-flex flex-column align-items-center">
                                                <img src="https://cdn.jsdelivr.net/npm/simple-icons@v13/icons/x.svg"
                                                     alt="X" width="28" height="28" style="filter: brightness(0) invert(1);"/>
                                                <span style="font-size:13px; margin-top: 4px;">X</span>
                                            </a>

                                            <!-- Facebook -->
                                            <a href="https://www.facebook.com/tenspakw/" target="_blank"
                                               class="text-white text-decoration-none d-flex flex-column align-items-center">
                                                <img src="https://cdn.jsdelivr.net/npm/simple-icons@v13/icons/facebook.svg"
                                                     alt="Facebook" width="28" height="28" style="filter: brightness(0) invert(1);"/>
                                                <span style="font-size:13px; margin-top: 4px;">Facebook</span>
                                            </a>

                                            <!-- YouTube -->
                                            <a href="https://www.youtube.com/@tenspakw" target="_blank"
                                               class="text-white text-decoration-none d-flex flex-column align-items-center">
                                                <img src="https://cdn.jsdelivr.net/npm/simple-icons@v13/icons/youtube.svg"
                                                     alt="YouTube" width="28" height="28" style="filter: brightness(0) invert(1);"/>
                                                <span style="font-size:13px; margin-top: 4px;">YouTube</span>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- BOTTOM BAR -->
                    <div class="container mt-5 pt-4 border-top border-secondary">

                        <div class="row text-center">
                            <div class="col-12">
                                <span style="font-size:13px; display: block; margin-bottom: 10px;">
                                    © 2025 Ten Wellness | All Rights Reserved.
                                </span>
                            </div>
                        </div>
                    </div>
                    <!-- foooter end -->
                    <script type="text/javascript">
                        document.addEventListener("DOMContentLoaded", function () {
                        const form = document.getElementById("aesop-newsletter-form");
                        const loadSwal = async () => {
                        if (typeof Swal === "undefined") {
                        await new Promise((resolve) => {
                        const script = document.createElement("script");
                        script.src = "/insabhi_custom_website/static/src/lib/sweetalert2.min.js";
                        script.onload = resolve;
                        document.head.appendChild(script);
                        });
                        }
                        };
                        form.addEventListener("submit", async function (e) {
                        e.preventDefault();
                        await loadSwal();
                        const email = form.email.value;
                        try {
                        const response = await fetch("/submit/newsletter", {
                        method: "POST",
                        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                        body: JSON.stringify({ email })
                        });
                        if (response.ok) {
                        Swal.fire({ icon: 'success', title: 'Success!', text: 'Subscribed!' }).then(() =>
                        location.reload());
                        } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: 'Try again.' });
                        }
                        } catch (err) {
                        Swal.fire({ icon: 'error', title: 'Error', text: 'Network issue.' });
                        }
                        });
                        });


                        <!--navlink dropdown-->

                    </script>
                    <script type="text/javascript"
                            src="/insabhi_custom_website/static/src/js/mobileDropdown/mobileDropdown.js"/>

                </footer>
            </xpath>
        </template>

    </data>
</odoo>