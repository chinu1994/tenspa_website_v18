                    <!-- foooter end -->
                    <script type="text/javascript">
                        document.addEventListener("DOMContentLoaded", function () {
                        const form = document.getElementById("aesop-newsletter-form");
                        const loadSwal = async () => {
                        if (typeof Swal === "undefined") {
                        await new Promise((resolve) => {
                        const script = document.createElement("script");
                        script.src = "/insabhi_custom_website/static/src/lib/sweetalert2.min.js";
                        script.onload = resolve;
                        document.head.appendChild(script);
                        });
                        }
                        };
                        form.addEventListener("submit", async function (e) {
                        e.preventDefault();
                        await loadSwal();
                        const email = form.email.value;
                        try {
                        const response = await fetch("/submit/newsletter", {
                        method: "POST",
                        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                        body: JSON.stringify({ email })
                        });
                        if (response.ok) {
                        Swal.fire({ icon: 'success', title: 'Success!', text: 'Subscribed!' }).then(() =>
                        location.reload());
                        } else {
                        Swal.fire({ icon: 'error', title: 'Error', text: 'Try again.' });
                        }
                        } catch (err) {
                        Swal.fire({ icon: 'error', title: 'Error', text: 'Network issue.' });
                        }
                        });
                        });


                        <!--navlink dropdown-->

                    </script>
