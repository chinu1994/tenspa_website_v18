<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- ================== HEADER ================== -->
        <template id="insabhi_custom_header" inherit_id="website.layout" name="Insabhi Custom Header">

            <!-- Default header ko replace karo, aur login page par hide karo -->
            <xpath expr="//header" position="replace">
                <t t-if="not request.httprequest.path.startswith('/web/login')">
                    <header>
                        <div class="insabhi-header-wrapper">

                            <div class="insabhi-top-banner text-center py-2">
                                Enjoy complimentary shipping with orders over 51KD.
                            </div>

                            <nav class="navbar navbar-expand-lg insabhi-navbar">
                                <div class="container-fluid d-flex flex-column">
                                    <div class="d-flex w-100 align-items-center position-relative">

                                        <a class="navbar-brand" href="/">
                                            <img src="/insabhi_custom_website/static/src/Images/logo.png" alt="Tēnspa"
                                                 class="logo-default img-fluid"/>
                                            <img src="/insabhi_custom_website/static/src/Images/logo1.0.png" alt="Tēnspa"
                                                 class="logo-hover img-fluid"/>
                                        </a>

                                        <button class="navbar-toggler d-lg-none" type="button"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#insabhiNavbarCollapse"
                                                aria-controls="insabhiNavbarCollapse"
                                                aria-expanded="false" aria-label="Toggle navigation">
                                            <div class="line"></div>
                                            <div class="line"></div>
                                            <div class="line"></div>
                                        </button>

<!--                                        <div class="insabhi-left-links d-none d-lg-flex align-items-center me-auto gap-4">-->
<!--                                            <a class="nav-link">Stores</a>-->

<!--                                        </div>-->

                                        <div class="insabhi-right-icons d-none d-lg-flex align-items-center gap-3">
                                            <form class="insabhi-search-form d-flex me-3 position-relative">
                                                <input class="form-control me-2 ps-5" type="search" placeholder="Search…"
                                                       aria-label="Search"/>
                                                <i class="fa fa-search position-absolute top-50 start-0 translate-middle-y ms-3 text-white"></i>
                                                <button class="btn btn-search" type="submit">Search</button>
                                            </form>
                                            <a class="nav-link">My cart</a>
                                        </div>
                                    </div>

                                    <div class="insabhi-bottom-menu d-none d-lg-flex justify-content-center w-100 py-3 gap-5 mt-2">

                                        <a class="nav-link" href="/">Home</a>
                                        <a class="nav-link" href="/aboutus">About Us</a>

                                        <div class="nav-item dropdown">
                                            <a class="nav-link dropdown-toggle" href="/treatment"
                                               aria-expanded="false">
                                                Treatment
                                            </a>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <a class="dropdown-item" href="/treatmentHim">Ten Treatments For Him</a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" href="/treatmentHer">Ten Treatments For Her</a>
                                                </li>
                                            </ul>
                                        </div>
                                        <a class="nav-link" href="/giftVoucher">Gift Vouchers</a>
                                        <a class="nav-link" href="/tenStore">Ten Store</a>
                                        <a class="nav-link" href="/careers">Careers</a>
                                        <a class="nav-link" href="/contactus">Contact Us</a>
                                        <a class="nav-link" href="/faq">FAQ</a>

                                    </div>
                                </div>
                            </nav>

                            <div class="collapse navbar-collapse d-lg-none" id="insabhiNavbarCollapse">
                                <ul class="navbar-nav mx-auto text-center">

                                    <li class="nav-item border-bottom border-light-subtle pb-2 mb-2">
                                        <a class="nav-link" href="/">Home</a>
                                    </li>
                                    <li class="nav-item  border-bottom border-light-subtle pb-2 mb-2">
                                        <a class="nav-link" href="/aboutus">About Us</a>
                                    </li>

                                    <li class="nav-item dropdown pb-2 mb-2">
                                        <a class="nav-link dropdown-toggle" href="#" aria-expanded="false"
                                           data-bs-toggle="dropdown" role="button" data-nav-url="/treatment">Treatment
                                        </a>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a class="dropdown-item" href="/treatmentHim">Ten Treatments For Him</a>
                                            </li>
                                            <li>
                                                <a class="dropdown-item" href="/treatmentHer">Ten Treatments For Her</a>
                                            </li>
                                        </ul>
                                    </li>
                                      <li class="nav-item border-bottom border-light-subtle pb-2 mb-2">
                                        <a class="nav-link" href="/giftVoucher">Gift Vouchers</a>
                                    </li>
                                     <li class="nav-item border-bottom border-light-subtle pb-2 mb-2">
                                        <a class="nav-link" href="/tenStore">Ten Store</a>
                                    </li>
                                    <li class="nav-item border-bottom border-light-subtle pb-2 mb-2">
                                        <a class="nav-link" href="/tenStore">Ten Store</a>
                                    </li>
                                    <li class="nav-item border-bottom border-light-subtle pb-2 mb-2">
                                        <a class="nav-link" href="/careers">Careers</a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link" href="/contactus">Contact Us</a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link" href="/faq">FAQ</a>
                                    </li>

                                </ul>
                            </div>

                        </div>
                    </header>
                </t>
            </xpath>

        </template>

        <!-- ================== FOOTER (unchanged) ================== -->
