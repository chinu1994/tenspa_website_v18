            <!-- CART DRAWER (Right Side) -->
            <div id="cart-drawer" style="display:none; position:fixed; top:0; right:0; width:420px; height:100%; background:#fff; z-index:1050; box-shadow:-5px 0 20px rgba(0,0,0,0.15); overflow-y:auto; padding:20px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; border-bottom:1px solid #eee; padding-bottom:10px;">
                    <h4 class="mb-0">My Cart (<span id="drawer-item-count">0</span>)</h4>
                    <button id="close-cart" style="background:none; border:none; font-size:1.8rem; cursor:pointer;">&amp;times;</button>
                </div>
