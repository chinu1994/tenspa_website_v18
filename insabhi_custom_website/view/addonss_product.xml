<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- Action + Menu -->
    <record id="action_ten_product_card" model="ir.actions.act_window">
      <field name="name">Ten Spa Products</field>
      <field name="res_model">ten.product.card</field>
      <!-- FIXED: use tree,form -->
      <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ten_website_root" name="Ten Spa" sequence="10"/>
    <menuitem id="menu_ten_products" name="Products" parent="menu_ten_website_root" action="action_ten_product_card" sequence="10"/>

    <!-- Tree view (FIXED: use <tree> not <list>) -->
    <record id="view_ten_product_card_tree" model="ir.ui.view">
      <field name="name">ten.product.card.tree</field>
      <field name="model">ten.product.card</field>
      <field name="arch" type="xml">
        <list>
          <field name="sequence"/>
          <field name="name"/>
          <field name="price"/>
          <field name="tag"/>
          <field name="active"/>
        </list>
      </field>
    </record>

    <!-- Form view -->
    <record id="view_ten_product_card_form" model="ir.ui.view">
      <field name="name">ten.product.card.form</field>
      <field name="model">ten.product.card</field>
      <field name="arch" type="xml">
        <form string="Product Card">
          <sheet>
            <group>
              <field name="name"/>
              <field name="subtitle"/>
              <field name="price"/>
              <field name="tag"/>
              <field name="size_option_ids" widget="many2many_tags"/>
              <field name="sequence"/>
              <field name="active"/>
            </group>
            <group>
              <field name="image" widget="image" options="{'preview_image': 'image'}"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

  </data>
</odoo>
