<odoo>
    <template id="dynamic_products_list" name="Ten Store Product List">
        <t t-call="website.layout">

            <div class="container mt-5">
                <div class="row">

                    <t t-foreach="products" t-as="p">

                        <div class="col-12 col-md-4 mb-5">

                            <div class="product-card shadow-sm">

                                <p class="tag">
                                    <t t-esc="p.tag == 'new' and 'NEW ADDITION' or 'BELOVED FORMULATION'"/>
                                </p>

                                <div class="image-container">
                                    <img t-att-src="'data:image/png;base64,%s' % p.image"/>
                                </div>

                                <h4 class="title mt-3"><t t-esc="p.name"/></h4>
                                <p class="subtitle text-muted"><t t-esc="p.subtitle"/></p>

                                <p class="price mt-2">$<t t-esc="p.price"/></p>

                                <a href="#" class="btn btn-dark w-100 mt-3">
                                    ADD TO CART
                                </a>

                            </div>
                        </div>

                    </t>

                </div>
            </div>

        </t>
    </template>
</odoo>
