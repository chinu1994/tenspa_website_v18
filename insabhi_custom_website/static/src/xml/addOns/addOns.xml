<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="insabhi_custom_website.AddOns" owl="1">

<!--        change hare start -->

        <section class="insabhi-hero-video position-relative" style="min-height:80vh;">
            <div class="position-absolute top-0 start-0 w-100 h-100" style="z-index:0;">
                <img src="insabhi_custom_website/static/src/image/img_1.jpg"
                     alt="Ten Wellness Hero"
                     class="w-100 h-100 object-fit-cover d-block"/>
            </div>
            <div class="insabhi-hero-overlay-bottom">
                <div class="insabhi-hero-content-bottom container">
                    <h1 class="insabhi-hero-title">Welcome To Add Ons</h1>
                   <p>
                        A premium transportation service offering round-trip rides to and from your home
                        using the latest luxury cars.
                    </p>
                </div>
            </div>
        </section>


<!--        card start-->

        <section class="insabhi-new-notable py-5">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="insabhi-section-title">Prestige drive service</h2>
            <p class="insabhi-section-subtitle">
                Experience the perfect blend of enduring favorites and the latest innovations.
            </p>
        </div>

        <!-- GRID VIEW - NO CAROUSEL -->
        <div class="row g-4">
            <t t-foreach="[0,1,2,3,4,5]" t-as="index" t-key="index">
                <div class="col-sm-6 col-lg-4">
                    <div class="insabhi-product-card text-center d-flex flex-column h-100 mx-auto"
                         style="max-width:460px; min-height:560px;">

                        <div class="insabhi-product-label">
                            <t t-if="index === 0">New addition</t>
                            <t t-else="">Beloved formulation</t>
                        </div>

                        <img t-att-src="'/insabhi_custom_website/static/src/image/pro' + (index + 1) + '.jpg'"
                             alt="Product" class="img-fluid mb-3 mx-auto d-block"
                             style="height:250px; object-fit:contain;"/>

                        <h3 class="insabhi-product-name mt-auto mb-2"
                            style="font-size:1.05rem;line-height:1.3;">
                            <t t-if="index === 0">Eleos Nourishing Body Cleanser</t>
                            <t t-elif="index === 1">Resurrection Aromatique Hand Wash</t>
                            <t t-else="">Placeholder Product</t>
                        </h3>

                        <p class="insabhi-product-scent text-muted small mb-2"
                           style="font-size:0.85rem;">
                            <t t-if="index === 0">Herbaceous, woody, spicy</t>
                            <t t-else="">Clear, low-foaming gel</t>
                        </p>

                        <div class="insabhi-product-size mb-2">
                            <select class="form-select form-select-sm">
                                <option>6.2 oz</option>
                            </select>
                        </div>

                        <p class="insabhi-product-price fw-bold mb-3" style="font-size:1.1rem;">
                            <t t-if="index === 0">K.D37.00</t>
                            <t t-else="">K.D46.00</t>
                        </p>

                        <button class="insabhi-add-to-cart mt-auto w-100 btn-sm">Add to cart</button>
                    </div>
                </div>
            </t>
        </div>
        <!-- END GRID -->

        <section class="insabhi-browse-category py-5 bg-white position-relative overflow-hidden"></section>
    </div>
</section>


            <!--END-->
        <!-- START: WhatsApp Icon -->
        <a href="https://api.whatsapp.com/send?phone=96522288282"
           class="position-fixed bg-success text-white rounded-circle shadow-lg d-flex align-items-center justify-content-center whatsapp-fixed-btn"
           style="width: 60px; height: 60px; z-index: 1000;"
           target="_blank" rel="noopener noreferrer">
    <i class="bi bi-whatsapp" style="font-size: 1.8rem;"></i>
</a>


        <style>
    /* Custom CSS classes for reliable fixed positioning (replaces bottom-4 end-4) */
    .whatsapp-fixed-btn {
        /* approx 1.5rem or 24px from bottom and right */
        bottom: 1.5rem;
        right: 1.5rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    /* Add WhatsApp icon hover effect */
    .whatsapp-fixed-btn:hover {
        transform: scale(1.1);
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.3) !important;
    }
</style>

        <!-- END: WhatsApp Icon -->


