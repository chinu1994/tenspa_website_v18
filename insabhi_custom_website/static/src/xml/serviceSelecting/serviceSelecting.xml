<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="insabhi_custom_website.ServiceSelecting" owl="1">
    <div class="serviceSelecting-redesigned">
        <!-- Complete redesign: left sidebar with steps + vertical line, right side content area -->

        <div class="main-container">
            <!-- LEFT SIDEBAR -->
            <div class="sidebar-section">
                <!-- Header/Banner -->
                <div class="sidebar-header">
                    <h2 class="treatment-title">
                        <t t-if="state.currentStep === 'category'">Book Treatment</t>
                        <t t-elif="state.currentStep === 'service'">Select Service</t>
                        <t t-elif="state.currentStep === 'time'">Choose Time</t>
                        <t t-elif="state.currentStep === 'amount'">Review Order</t>
                        <t t-elif="state.currentStep === 'payment'">Payment</t>
                    </h2>
                    <p class="treatment-subtitle">
                        <t t-if="state.selectedCategory">
                            <t t-esc="categories.find(c => c.id === state.selectedCategory)?.name"/>
                        </t>
                        <t t-else="">Select Category</t>
                    </p>
                </div>

                <!-- VERTICAL LINE WITH STEPS -->
                <div class="steps-container">
                    <!-- Step 1: Category -->
                    <div class="step-item" t-att-class="{ 'active': state.currentStep === 'category' or ['service', 'time', 'amount', 'payment'].includes(state.currentStep) }">
                        <div class="step-circle" t-att-class="{ 'active': state.currentStep === 'category', 'completed': ['service', 'time', 'amount', 'payment'].includes(state.currentStep) }">
                            <t t-if="['service', 'time', 'amount', 'payment'].includes(state.currentStep)">
                                <i class="fa fa-check"></i>
                            </t>
                            <t t-else="">1</t>
                        </div>
                        <div class="step-label">Category</div>
                    </div>

                    <div class="vertical-line" t-att-class="{ 'active': state.currentStep !== 'category' }"></div>

                    <!-- Step 2: Service -->
                    <div class="step-item" t-att-class="{ 'active': state.currentStep === 'service' or ['time', 'amount', 'payment'].includes(state.currentStep) }">
                        <div class="step-circle" t-att-class="{ 'active': state.currentStep === 'service', 'completed': ['time', 'amount', 'payment'].includes(state.currentStep) }">
                            <t t-if="['time', 'amount', 'payment'].includes(state.currentStep)">
                                <i class="fa fa-check"></i>
                            </t>
                            <t t-else="">2</t>
                        </div>
                        <div class="step-label">Service</div>
                    </div>

                    <div class="vertical-line" t-att-class="{ 'active': state.currentStep !== 'category' and state.currentStep !== 'service' }"></div>

                    <!-- Step 3: Time -->
                    <div class="step-item" t-att-class="{ 'active': state.currentStep === 'time' or ['amount', 'payment'].includes(state.currentStep) }">
                        <div class="step-circle" t-att-class="{ 'active': state.currentStep === 'time', 'completed': ['amount', 'payment'].includes(state.currentStep) }">
                            <t t-if="['amount', 'payment'].includes(state.currentStep)">
                                <i class="fa fa-check"></i>
                            </t>
                            <t t-else="">3</t>
                        </div>
                        <div class="step-label">Time</div>
                    </div>

                    <div class="vertical-line" t-att-class="{ 'active': state.currentStep === 'amount' or state.currentStep === 'payment' }"></div>

                    <!-- Step 4: Amount -->
                    <div class="step-item" t-att-class="{ 'active': state.currentStep === 'amount' or state.currentStep === 'payment' }">
                        <div class="step-circle" t-att-class="{ 'active': state.currentStep === 'amount', 'completed': state.currentStep === 'payment' }">
                            <t t-if="state.currentStep === 'payment'">
                                <i class="fa fa-check"></i>
                            </t>
                            <t t-else="">4</t>
                        </div>
                        <div class="step-label">Amount</div>
                    </div>

                    <div class="vertical-line" t-att-class="{ 'active': state.currentStep === 'payment' }"></div>

                    <!-- Step 5: Payment -->
                    <div class="step-item" t-att-class="{ 'active': state.currentStep === 'payment' }">
                        <div class="step-circle" t-att-class="{ 'active': state.currentStep === 'payment' }">5</div>
                        <div class="step-label">Payment</div>
                    </div>
                </div>
            </div>

            <!-- RIGHT CONTENT AREA -->
            <div class="content-section">
                <!-- STEP 1: CATEGORY SELECTION -->
                <t t-if="state.currentStep === 'category'">
                    <div class="content-wrapper">
                        <h3 class="content-title">Select Treatment Category</h3>
                        <p class="content-subtitle">Choose the service category that suits you</p>

                        <div class="categories-grid">
                            <t t-foreach="categories" t-as="cat" t-key="cat.id">
                                <div class="category-card-item" t-att-class="{ 'selected': state.selectedCategory === cat.id }"
                                     t-on-click="() => this.selectCategoryAndMove(cat.id)">
                                    <img t-att-src="cat.image" class="category-image"/>
                                    <div class="category-overlay">
                                        <h5><t t-esc="cat.name"/></h5>
                                        <t t-if="state.selectedCategory === cat.id">
                                            <div class="selected-badge">SELECTED</div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <div class="action-buttons mt-5">
                            <button class="btn-next" t-att-disabled="!state.selectedCategory" t-on-click="moveToService">
                                NEXT <i class="fa fa-arrow-right ms-2"></i>
                            </button>
                        </div>
                    </div>
                </t>

                <!-- STEP 2: SERVICE SELECTION -->
                <t t-if="state.currentStep === 'service'">
                    <div class="content-wrapper">
                        <h3 class="content-title">Select Your Service</h3>
                        <p class="content-subtitle">
                            <t t-esc="categories.find(c => c.id === state.selectedCategory)?.name"/> Services
                        </p>

                        <div class="services-grid">
                            <t t-foreach="getCurrentServices()" t-as="service" t-key="service_index">
                                <div class="service-card-item" t-att-class="{ 'selected': state.selectedService and state.selectedService.name === service.name }"
                                     t-on-click="() => this.selectServiceOnly(service)">
                                    <img t-att-src="service.img" class="service-image"/>
                                    <div class="service-overlay">
                                        <h5><t t-esc="service.name"/></h5>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- DURATION SELECTION -->
                        <t t-if="state.selectedService">
                            <div class="duration-section mt-5">
                                <h5 class="mb-3">Select Duration:</h5>
                                <div class="duration-buttons-group">
                                    <button class="duration-btn" t-att-class="{ 'active': state.selectedDuration === 60 }"
                                            t-on-click="() => this.selectDuration(60, 29.5)">1 Hour</button>
                                    <button class="duration-btn" t-att-class="{ 'active': state.selectedDuration === 90 }"
                                            t-on-click="() => this.selectDuration(90, 42.0)">1.5 Hours</button>
                                    <button class="duration-btn" t-att-class="{ 'active': state.selectedDuration === 120 }"
                                            t-on-click="() => this.selectDuration(120, 52.0)">2 Hours</button>
                                </div>
                            </div>
                        </t>

                        <div class="action-buttons mt-5">
                            <button class="btn-back" t-on-click="goBackToCategory">
                                <i class="fa fa-arrow-left me-2"></i> BACK
                            </button>
                            <button class="btn-next" t-att-disabled="!state.selectedService or !state.selectedDuration" t-on-click="moveToTime">
                                NEXT <i class="fa fa-arrow-right ms-2"></i>
                            </button>
                        </div>
                    </div>
                </t>

                <!-- STEP 3: TIME SELECTION -->
                <t t-if="state.currentStep === 'time'">
                    <div class="content-wrapper">
                        <h3 class="content-title">Select Your Time Slot</h3>
                        <p class="content-subtitle">Choose a convenient date and time</p>

                        <!-- DATE SELECTION -->
                        <div class="date-section mb-5">
                            <h5 class="mb-3">Select Date:</h5>
                            <div class="date-buttons-group">
                                <button class="date-btn" t-att-class="{ 'active': state.selectedDate === 'today' }"
                                        t-on-click="() => this.selectDate('today')">
                                    <div class="date-label">Today</div>
                                    <div class="date-value">Dec 7</div>
                                </button>
                                <button class="date-btn" t-att-class="{ 'active': state.selectedDate === 'tomorrow' }"
                                        t-on-click="() => this.selectDate('tomorrow')">
                                    <div class="date-label">Tomorrow</div>
                                    <div class="date-value">Dec 8</div>
                                </button>
                                <button class="date-btn" t-att-class="{ 'active': state.selectedDate === 'other' }"
                                        t-on-click="() => this.selectDate('other')">
                                    <i class="fa fa-calendar me-2"></i>
                                    Pick Another Day
                                </button>
                            </div>
                        </div>

                        <!-- TIME SELECTION -->
                        <div class="time-section">
                            <h5 class="mb-3">Select Time Slot:</h5>
                            <div class="time-buttons-group">
                                <button class="time-btn" t-att-class="{ 'active': state.selectedTime === '9am-11am' }"
                                        t-on-click="() => this.selectTime('9am-11am')">9:00 AM - 11:00 AM</button>
                                <button class="time-btn" t-att-class="{ 'active': state.selectedTime === '11am-1pm' }"
                                        t-on-click="() => this.selectTime('11am-1pm')">11:00 AM - 1:00 PM</button>
                                <button class="time-btn" t-att-class="{ 'active': state.selectedTime === '1pm-3pm' }"
                                        t-on-click="() => this.selectTime('1pm-3pm')">1:00 PM - 3:00 PM</button>
                                <button class="time-btn" t-att-class="{ 'active': state.selectedTime === '3pm-5pm' }"
                                        t-on-click="() => this.selectTime('3pm-5pm')">3:00 PM - 5:00 PM</button>
                                <button class="time-btn" t-att-class="{ 'active': state.selectedTime === '5pm-7pm' }"
                                        t-on-click="() => this.selectTime('5pm-7pm')">5:00 PM - 7:00 PM</button>
                                <button class="time-btn" t-att-class="{ 'active': state.selectedTime === '7pm-9pm' }"
                                        t-on-click="() => this.selectTime('7pm-9pm')">7:00 PM - 9:00 PM</button>
                            </div>
                        </div>

                        <div class="action-buttons mt-5">
                            <button class="btn-back" t-on-click="goBackToService">
                                <i class="fa fa-arrow-left me-2"></i> BACK
                            </button>
                            <button class="btn-next" t-att-disabled="!state.selectedDate or !state.selectedTime" t-on-click="moveToAmount">
                                NEXT <i class="fa fa-arrow-right ms-2"></i>
                            </button>
                        </div>
                    </div>
                </t>

                <!-- STEP 4: AMOUNT/PERSONALIZATION -->
                <t t-if="state.currentStep === 'amount'">
                    <div class="content-wrapper">
                        <h3 class="content-title">Review Your Order</h3>
                        <p class="content-subtitle">Check details and personalize your gift</p>

                        <!-- ORDER SUMMARY -->
                        <div class="order-summary-box">
                            <div class="summary-item">
                                <div class="summary-label">Service:</div>
                                <div class="summary-value"><t t-esc="state.selectedService?.name"/></div>
                            </div>
                            <div class="summary-item">
                                <div class="summary-label">Duration:</div>
                                <div class="summary-value"><t t-esc="state.selectedDuration"/> minutes</div>
                            </div>
                            <div class="summary-item">
                                <div class="summary-label">Date:</div>
                                <div class="summary-value"><t t-esc="state.selectedDate"/></div>
                            </div>
                            <div class="summary-item">
                                <div class="summary-label">Time:</div>
                                <div class="summary-value"><t t-esc="state.selectedTime"/></div>
                            </div>
                            <div class="summary-divider"></div>
                            <div class="summary-total">
                                <div class="total-label">Total:</div>
                                <div class="total-value">KWD <t t-esc="state.selectedPrice"/></div>
                            </div>
                        </div>

                        <!-- PERSONALIZATION FORM -->
                        <div class="personalization-section mt-5">
                            <h5 class="mb-3">Personalize Your Gift:</h5>

                            <div class="form-group mb-3">
                                <label class="form-label">Recipient Name *</label>
                                <input type="text" class="form-control" placeholder="Enter recipient's name" t-model="state.recipientName"/>
                            </div>

                            <div class="form-group mb-3">
                                <label class="form-label">Your Message *</label>
                                <textarea class="form-control" rows="4" placeholder="Write your message..." maxlength="180" t-model="state.message"></textarea>
                                <small class="text-muted">
                                    <t t-esc="180 - (state.message ? state.message.length : 0)"/> characters left
                                </small>
                            </div>

                            <div class="form-group mb-3">
                                <label class="form-label">Your Name (Optional)</label>
                                <input type="text" class="form-control" placeholder="Your name" t-model="state.senderName"/>
                            </div>
                        </div>

                        <div class="action-buttons mt-5">
                            <button class="btn-back" t-on-click="goBackToTime">
                                <i class="fa fa-arrow-left me-2"></i> BACK
                            </button>
                            <button class="btn-next" t-att-disabled="!state.recipientName.trim() or !state.message.trim()" t-on-click="moveToPayment">
                                NEXT <i class="fa fa-arrow-right ms-2"></i>
                            </button>
                        </div>
                    </div>
                </t>

                <!-- STEP 5: PAYMENT -->
                <t t-if="state.currentStep === 'payment'">
                    <div class="content-wrapper">
                        <h3 class="content-title">Complete Payment</h3>
                        <p class="content-subtitle">Review and confirm your order</p>

                        <!-- FINAL ORDER SUMMARY -->
                        <div class="final-summary-box">
                            <div class="summary-card">
                                <h5 class="mb-3">Order Details</h5>
                                <div class="detail-row">
                                    <span class="detail-label">Service:</span>
                                    <span class="detail-value"><t t-esc="state.selectedService?.name"/></span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Duration:</span>
                                    <span class="detail-value"><t t-esc="state.selectedDuration"/> minutes</span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Date:</span>
                                    <span class="detail-value"><t t-esc="state.selectedDate"/></span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Time:</span>
                                    <span class="detail-value"><t t-esc="state.selectedTime"/></span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Recipient:</span>
                                    <span class="detail-value"><t t-esc="state.recipientName"/></span>
                                </div>
                            </div>

                            <div class="summary-card mt-3">
                                <h5 class="mb-3">Price Breakdown</h5>
                                <div class="detail-row">
                                    <span class="detail-label">Service Price:</span>
                                    <span class="detail-value">KWD <t t-esc="state.selectedPrice"/></span>
                                </div>
                                <div class="detail-row">
                                    <span class="detail-label">Shipping:</span>
                                    <span class="detail-value">FREE</span>
                                </div>
                                <div class="divider"></div>
                                <div class="detail-row total-row">
                                    <span class="detail-label">Total Amount:</span>
                                    <span class="detail-value total">KWD <t t-esc="state.selectedPrice"/></span>
                                </div>
                            </div>
                        </div>

                        <!-- PAYMENT METHOD -->
                        <div class="payment-method-section mt-5">
                            <h5 class="mb-3">Payment Method</h5>
                            <div class="payment-options">
                                <label class="payment-option">
                                    <input type="radio" name="payment" value="card" t-model="state.paymentMethod" checked="checked"/>
                                    <span>Credit/Debit Card</span>
                                </label>
                                <label class="payment-option">
                                    <input type="radio" name="payment" value="wallet" t-model="state.paymentMethod"/>
                                    <span>Digital Wallet</span>
                                </label>
                            </div>
                        </div>

                        <div class="action-buttons mt-5 pb-5">
                            <button class="btn-back" t-on-click="goBackToAmount">
                                <i class="fa fa-arrow-left me-2"></i> BACK
                            </button>
                            <button class="btn-complete" t-on-click="completePayment">
                                <i class="fa fa-lock me-2"></i> COMPLETE PAYMENT - KWD <t t-esc="state.selectedPrice"/>
                            </button>
                        </div>
                    </div>
                </t>
            </div>
        </div>

        <!-- WHATSAPP BUTTON -->
        <a href="https://api.whatsapp.com/send?phone=96522288282" class="whatsapp-btn"
           target="_blank" rel="noopener noreferrer">
            <i class="bi bi-whatsapp"></i>
        </a>

        <style>
            * { margin: 0; padding: 0; box-sizing: border-box; }

            .serviceSelecting-redesigned {
                background: #f8f8f8;
                min-height: 100vh;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                color: #333;
            }

            /* MAIN CONTAINER - FLEX LAYOUT */
            .main-container {
                display: flex;
                min-height: 100vh;
            }

            /* SIDEBAR SECTION */
            .sidebar-section {
                width: 30%;
                background: white;
                padding: 3rem 2rem;
                border-right: 1px solid #e0e0e0;
                overflow-y: auto;
                position: relative;
            }

            /* Header/Banner in Sidebar */
            .sidebar-header {
                text-align: center;
                margin-bottom: 3rem;
                padding-bottom: 2rem;
                border-bottom: 2px solid #d4b08c;
            }

            .treatment-title {
                font-size: 1.8rem;
                font-weight: 700;
                color: #d4b08c;
                margin-bottom: 0.5rem;
            }

            .treatment-subtitle {
                font-size: 0.95rem;
                color: #999;
                margin: 0;
            }

            /* STEPS CONTAINER */
            .steps-container {
                position: relative;
            }

            .step-item {
                display: flex;
                flex-direction: column;
                align-items: center;
                margin-bottom: 1.5rem;
                opacity: 0.5;
                transition: opacity 0.3s;
            }

            .step-item.active {
                opacity: 1;
            }

            .step-circle {
                width: 50px;
                height: 50px;
                border-radius: 50%;
                background: white;
                border: 3px solid #ddd;
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 700;
                color: #999;
                margin-bottom: 0.8rem;
                transition: all 0.3s;
                font-size: 1.2rem;
            }

            .step-circle.active {
                border-color: #d4b08c;
                color: white;
                background: #d4b08c;
            }

            .step-circle.completed {
                background: #28a745;
                border-color: #28a745;
                color: white;
            }

            .step-label {
                font-size: 0.85rem;
                font-weight: 600;
                color: #666;
                text-align: center;
            }

            /* VERTICAL LINE */
            .vertical-line {
                width: 3px;
                height: 30px;
                background: #ddd;
                margin: 0 auto 0.5rem;
                transition: background 0.3s;
            }

            .vertical-line.active {
                background: #d4b08c;
            }

            /* CONTENT SECTION */
            .content-section {
                flex: 1;
                padding: 3rem 4rem;
                overflow-y: auto;
                background: white;
            }

            .content-wrapper {
                max-width: 900px;
                margin: 0 auto;
            }

            .content-title {
                font-size: 2rem;
                font-weight: 700;
                color: #d4b08c;
                margin-bottom: 0.5rem;
            }

            .content-subtitle {
                font-size: 1rem;
                color: #999;
                margin-bottom: 2rem;
            }

            /* CATEGORIES GRID */
            .categories-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
                gap: 2rem;
                margin-bottom: 3rem;
            }

            .category-card-item {
                position: relative;
                height: 240px;
                border-radius: 16px;
                overflow: hidden;
                cursor: pointer;
                transition: transform 0.3s, box-shadow 0.3s;
                border: 3px solid transparent;
            }

            .category-card-item:hover {
                transform: translateY(-8px);
                box-shadow: 0 12px 24px rgba(0,0,0,0.15);
            }

            .category-card-item.selected {
                border-color: #d4b08c;
                box-shadow: 0 0 0 4px rgba(212,176,140,0.1);
            }

            .category-image {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .category-overlay {
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                background: linear-gradient(transparent, rgba(0,0,0,0.85));
                padding: 1.5rem 1rem 1rem;
                text-align: center;
            }

            .category-overlay h5 {
                color: white;
                font-weight: 700;
                margin: 0;
            }

            .selected-badge {
                background: #d4b08c;
                color: white;
                padding: 0.4rem 1rem;
                border-radius: 20px;
                font-size: 0.8rem;
                font-weight: 700;
                margin-top: 0.5rem;
                display: inline-block;
            }

            /* SERVICES GRID */
            .services-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                gap: 2rem;
                margin-bottom: 3rem;
            }

            .service-card-item {
                position: relative;
                height: 300px;
                border-radius: 16px;
                overflow: hidden;
                cursor: pointer;
                transition: transform 0.3s, box-shadow 0.3s;
                border: 3px solid transparent;
            }

            .service-card-item:hover {
                transform: translateY(-8px);
                box-shadow: 0 12px 24px rgba(0,0,0,0.15);
            }

            .service-card-item.selected {
                border-color: #d4b08c;
                box-shadow: 0 0 0 4px rgba(212,176,140,0.1);
            }

            .service-image {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .service-overlay {
                position: absolute;
                bottom: 0;
                left: 0;
                right: 0;
                background: linear-gradient(transparent, rgba(0,0,0,0.85));
                padding: 2rem 1rem 1.5rem;
                text-align: center;
            }

            .service-overlay h5 {
                color: white;
                font-weight: 700;
                margin: 0;
            }

            /* DURATION SECTION */
            .duration-section h5 {
                color: #d4b08c;
                font-weight: 700;
            }

            .duration-buttons-group {
                display: flex;
                gap: 1rem;
                flex-wrap: wrap;
            }

            .duration-btn {
                background: white;
                border: 2px solid #ddd;
                color: #666;
                padding: 10px 24px;
                border-radius: 50px;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.3s;
            }

            .duration-btn:hover {
                border-color: #d4b08c;
                color: #d4b08c;
            }

            .duration-btn.active {
                background: #d4b08c;
                border-color: #d4b08c;
                color: white;
            }

            /* DATE &amp; TIME SECTIONS */
            .date-section h5,
            .time-section h5 {
                color: #d4b08c;
                font-weight: 700;
            }

            .date-buttons-group,
            .time-buttons-group {
                display: grid;
                gap: 1rem;
            }

            .date-btn,
            .time-btn {
                background: white;
                border: 2px solid #ddd;
                color: #666;
                padding: 12px 16px;
                border-radius: 12px;
                font-weight: 500;
                cursor: pointer;
                transition: all 0.3s;
                text-align: left;
            }

            .date-btn:hover,
            .time-btn:hover {
                border-color: #d4b08c;
                background: #f9f5f0;
            }

            .date-btn.active,
            .time-btn.active {
                background: #d4b08c;
                border-color: #d4b08c;
                color: white;
            }

            .date-label {
                font-size: 0.8rem;
