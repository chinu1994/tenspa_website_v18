<!--            transform: translateX(0);-->
<!--        }-->

        .service-summary-card {
            background: #000;
            border-radius: 20px;
            padding: 1.8rem;
            color: white;
            box-shadow: 0 10px 30px rgba(0,0,0,0.4);
            width: 100%;
            max-width: 420px;
            margin-top: 30px;
        }

        .service-summary-card img {
            width: 100%;
            height: 250px;
            object-fit: cover;
            border-radius: 16px;
        }

        .service-summary-card .price-display {
            font-size: 2.4rem;
            font-weight: 800;
            color: #d4b08c;
        }

        .service-summary-card .add-to-cart-btn {
            background: transparent;
            border: 2px solid #d4b08c;
            color: white;
            padding: 16px 40px;
            border-radius: 50px;
            font-size: 1.2rem;
            width: 100%;
            font-weight: 700;
            transition: 0.3s;
        }

        .service-summary-card .add-to-cart-btn:hover {
            background: #d4b08c;
            transform: scale(1.05);
        }

        .summary-inner { max-width: 380px; margin: 0 auto; position: relative; }
        .close-sidebar {
            position: absolute; top: -15px; right: -15px; background: white; color: black;
            width: 50px; height: 50px; border-radius: 50%; font-size: 2rem; border: none; cursor: pointer;
        }
        .summary-img { width: 100%; height: 320px; object-fit: cover; border-radius: 16px; margin-bottom: 1.5rem; }
        .price-display { font-size: 2.8rem; font-weight: 800; color: #d4b08c; margin: 1rem 0; }
        .add-to-cart-btn {
            background: transparent; border: 2px solid #d4b08c; color: white;
            padding: 16px 40px; border-radius: 50px; font-size: 1.2rem; font-weight: 700;
            width: 100%; transition: 0.3s;
        }
        .add-to-cart-btn:hover { background: #d4b08c; transform: scale(1.05); }

        @media (max-width: 992px) {
            .service-summary-sidebar { max-width: 100%; }
        }
    </style>
</t>
</templates>