<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="insabhi_custom_website.GiftVoucher" owl="1">
        <div class="gift-voucher-container">
            <!-- Video Background -->
            <video autoplay="autoplay" muted="muted" loop="loop" id="giftVideoBackground" class="gift-video-background">
                <source src="/insabhi_custom_website/static/src/Images/GV_Banner.mp4" type="video/mp4"/>
                Your browser does not support the video tag.
            </video>

            <!-- Overlay Content -->
            <div class="gift-overlay-content">
                <div class="gift-statement mt-3">
                    <h1>Give the Gift of Relaxation</h1>
                    <p>Discover our premium spa services and share the experience with your loved ones</p>
                </div>

<!--                <button id="giftNowBtn" class="couture-btn royal" type="button">GIFT NOW</button>-->
            </div>

            <!-- First Time Purchase Question Popup -->
            <div id="simplePopup" class="simple-popup" style="display: none;">
                <div class="popup-content">
                    <span class="popup-close"><i class="bi bi-x-lg"></i></span>
                    <div id="genderSelection" style="display: block; margin-bottom: 20px;">
                        <div style="display: flex; justify-content: center; align-items: center;">
                        <button id="giftForHimBtn" class="couture-btn royal me-3" type="button">GIFT FOR HIM</button>
                        <button id="giftForHerBtn" class="couture-btn empress" type="button">GIFT FOR HER</button>
                            </div>
                    </div>
<!--                    <h2>Gift Voucher</h2>-->
                    <p>Is this your first time purchasing a gift from Ten Spa?</p>
                    <div class="button-group">
                        <button id="yesBtn" class="option-btn yes-btn">Yes</button>
                        <button id="noBtn" class="option-btn no-btn">No</button>
                    </div>

                    <form id="giftForm" style="display: none;">
                        <div class="name-group" style="display: flex; gap: 10px; margin-bottom: 15px;">
                            <div class="form-group" style="flex: 1;">
                                  <label for="customerFirstName">First Name:</label>
                                   <input type="text" id="customerFirstName" name="customerFirstName" required="required"/>
                            </div>
                             <div class="form-group" style="flex: 1;">
                                   <label for="customerLastName">Last Name:</label>
                                  <input type="text" id="customerLastName" name="customerLastName" required="required"/>
                             </div>
                         </div>
                        <div class="form-group">
                                <label for="customerPhone">Phone Number:</label>
                                <input type="tel" id="customerPhone" name="customerPhone" required="required"/>
                        </div>
                        <div class="form-group">
                             <label for="customerAddress">Address:</label>
                            <textarea id="customerAddress" name="customerAddress" rows="3" required="required"></textarea>
                         </div>
                        <div class="form-group">
                            <label for="customerBirthdate">Birthdate:</label>
                            <input type="date" id="customerBirthdate" name="customerBirthdate" required="required"/>
                        </div>
                        <button type="submit" class="submit-btn">Submit</button>
                        </form>
                </div>
            </div>
        </div>

        <section class="luxury-etiquette py-5 bg-white">
            <div class="container py-5">
                <div class="text-center mb-5">
                    <div class="d-inline-flex align-items-center gap-4 mb-4">
                        <div class="flex-grow-1 h-05 bg-gold" style="background:#d4b08c;"></div>
<!--                        <h2 class="display-5 fw-light m-0 px-4" style="font-family:'Playfair Display',serif;">-->
<!--                            Thanks For Gifting-->
<!--                        </h2>-->
                        <div class="flex-grow-1 h-05 bg-gold" style="background:#d4b08c;"></div>
                    </div>

                    <!-- EXACT INTRO PARAGRAPH YOU PROVIDED – NOTHING ELSE -->
                    <p class="lead text-muted col-lg-10 mx-auto mb-5" style="line-height:1.9;">
                         Give the gift of relaxation and rejuvenation with Ten Wellness's gift vouchers.
                          Perfect for any occasion, our vouchers allow your loved ones to choose from a
                          range of luxurious treatments and services designed to refresh the body, mind,
                         and soul. Whether it’s a birthday, anniversary, or a simple gesture of appreciation,
                       a Ten Wellness gift voucher offers an unforgettable experience of tranquility and
                       indulgence.
                    </p>
                </div>
                <div class="gift-buttons d-flex justify-content-center">
<!--                    <button id="giftForHimBtn" class="couture-btn royal me-3"-->
<!--                            type="button">GIFT FOR HIM</button>-->
<!--                    <button id="giftForHerBtn" class="couture-btn empress"-->
<!--                            type="button">GIFT FOR HER</button>-->
                    <button id="giftNowBtn" class="couture-btn royal" type="button">GIFT NOW</button>
                </div>
                <div class="text-center mt-5">
<!--                    <p class="text-muted lead">Thank you for understanding and adhering to our policies.</p>-->
                </div>
            </div>
        </section>

