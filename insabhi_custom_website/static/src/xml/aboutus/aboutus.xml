<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="insabhi_custom_website.AboutUs" owl="1">
        <div class="aboutus">

            <!-- HERO -->
            <div class="hero-wrapper">
                <section class="insabhi-hero hero-aesop position-relative">
                    <div class="hero-image-wrapper">
                        <img src="insabhi_custom_website/static/src/image/about1.png"
                             alt="Our story hero"
                             class="hero-image"/>
                    </div>

                    <div class="hero-overlay">
                        <div class="container hero-text-container">
                            <h2 class="hero-title">Our story</h2>
                            <p class="hero-subtitle">
                                We offer skin, hair and body care formulations created with meticulous attention to detail,
                                and with efficacy and sensory pleasure in mind.
                            </p>
                        </div>
                    </div>
                </section>
            </div>


            <!-- OUR STORY -->
            <section class="s_our_story_ten py-5" data-snippet="s_our_story_ten">
                <div class="container maxwide">
                    <div class="row align-items-center g-5">

                        <!-- IMAGE LEFT -->
                        <div class="col-lg-6 text-center text-lg-start">
                            <div class="photo-card">
                                <img src="/insabhi_custom_website/static/src/image/about2.jpg"
                                     alt="Ten Wellness Sanctuary"
                                     class="main-image"/>
                            </div>
                        </div>

                        <!-- TEXT RIGHT -->
                        <div class="col-lg-5 ps-lg-5">
                            <div class="content-wrap">

                                <h2 class="section-heading">Our Story</h2>

                                <div class="story-copy">
                                    <p>
                                        Founded in 2017, <strong class="accent">Ten Wellness</strong> began with a
                                        simple aim:
                                        to offer considered, professional wellness experiences in a calm, refined
                                        setting.
                                    </p>

                                    <p>
                                        Today we remain committed to thoughtful treatments, personalised care and a peaceful atmosphere
                                        that helps guests restore balance of mind and body.
                                    </p>
                                </div>

                                <div class="brief-note">
                                    <p><strong class="accent">Since 2017 • Kuwait</strong></p>
                                    <p class="muted">
                                        We welcome appointments by prior booking and ask guests to observe a few simple guidelines to
                                        preserve the tranquil environment for everyone.
                                    </p>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </section>



            <!-- ✨ SPA ETIQUETTE SECTION (Clean & Minimal) -->
            <section class="spa-etiquette py-5">
                <div class="container maxwide text-center">

                    <h2 class="section-heading">Spa Etiquette</h2>
                    <p class="muted" style="max-width:60ch; margin:auto;">
                        A few guidelines to help preserve a peaceful and comfortable experience for all our guests.
                    </p>

                </div>

                <!-- Grid layout -->
                <div class="container maxwide mt-4">
                    <div class="etiquette-grid">

                        <div class="etiquette-item">
                            <h4>Arrival Time</h4>
                            <p>Please arrive at least 20 minutes prior to your scheduled appointment to ensure a smooth check-in.
                               Treatments end at the scheduled time.</p>
                        </div>

                        <div class="etiquette-item">
                            <h4>Late Arrivals</h4>
                            <p>Late arrival may shorten your treatment time to accommodate the next guest.</p>
                        </div>

                        <div class="etiquette-item">
                            <h4>Reservations</h4>
                            <p>We recommend booking 1–2 days in advance to secure your preferred time and service.</p>
                        </div>

                        <div class="etiquette-item">
                            <h4>Cancellations</h4>
                            <p>Please provide at least 4 hours’ notice for cancellations by calling us directly.</p>
                        </div>

                        <div class="etiquette-item">
                            <h4>Refunds</h4>
                            <p>Refund requests cannot be accommodated after the first 10 minutes of treatment.</p>
                        </div>

                        <div class="etiquette-item">
                            <h4>Valuables</h4>
                            <p>Please avoid bringing valuables. Lockers are provided, but management is not responsible
                               for lost items.</p>
                        </div>

                        <div class="etiquette-item">
                            <h4>No Mobiles &amp; No Smoking</h4>
                            <p>For privacy and tranquility, mobile phones and smoking are strictly prohibited.</p>
                        </div>

                        <div class="etiquette-item">
                            <h4>Health Declarations</h4>
                            <p>Please complete the consultation form and inform us of any health conditions, pregnancy,
                               allergies, or recent surgeries.</p>
                        </div>

                    </div>
                </div>

                <div class="container maxwide text-center mt-4">
                    <p class="muted" style="max-width:60ch; margin:auto;">
                        Thank you for understanding and adhering to our policies.
                    </p>
                </div>
            </section>


        </div>
    </t>

</templates>
