<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="insabhi_custom_website.VoucherDelivery" owl="1">
        <div class="voucherDelivery container py-4 px-3 px-md-5">
                      <!-- ==== HERO (matches uploaded image) ==== -->
            <section class="insabhi-hero-video position-relative height-fixer-hero">
                <div class="position-absolute top-0 start-0 w-100 h-100">
                    <img src="insabhi_custom_website/static/src/image/ParcelBanner.jpg"
                         alt="Hero" class="w-100 h-100 object-fit-cover"/>
                </div>
            
            </section>

            <!-- ==== TEN STORE CONTENT  AND CARD==== -->
            <section class="mb-5 Vpading">
                <div class="row mb-4 p-3 p-md-4 border rounded shadow-sm bg-white">
                    <div class="col-12">
                        <h3 class="mb-4 pb-2 border-bottom text-dark font-weight-bold">Shipping Method</h3>
                        <div class="d-flex justify-content-between align-items-center p-3 border rounded bg-light">
                             <span class="font-weight-bold h5 mb-0">Standard Delivery</span>
                             <span class="badge badge-success p-2 px-3">FREE</span>
                        </div>
                    </div>
                </div>

                <div class="row mb-4 p-3 p-md-4 border-bottom bg-white rounded shadow-sm">
                    <div class="col-12 d-flex align-items-center justify-content-between">
                        <div>
                            <i class="fa fa-map-marker-alt mr-2 text-primary"></i>
                            <span class="font-weight-bold h5">Ask the recipient for the address</span>
                            <p class="text-muted small mt-2 mb-0">We will collect the address from the recipient. Delivery time may be impacted if recipient is unreachable</p>
                        </div>
                        <label class="switch ml-3">
                            <input type="checkbox" checked="checked"/>
                            <span class="slider round"></span>
                        </label>
                    </div>
                </div>

               
 
                <div class="row mb-4 bg-white p-3 p-md-4 rounded shadow-sm">
                    <div class="col-12 mb-4">
                        <label class="mb-2 font-weight-bold text-dark small">RECIPIENT NAME</label>
                        <input type="text" class="form-control form-control-md rounded-pill px-3 py-2" placeholder="Enter recipient's full name"/>
                    </div>
                    <div class="col-12 mb-4">
                        <label class="mb-2 font-weight-bold text-dark small">RECIPIENT PHONE</label>
                        <input type="text" class="form-control form-control-md rounded-pill px-3 py-2" placeholder="Enter phone number"/>
            
                    </div>
                    
                </div>
                
                <div class="row mb-5 mt-4 bg-white p-3 p-md-4 rounded shadow-sm">
                    <div class="col-md-12 d-flex flex-column flex-md-row align-items-md-center">
                        <div class="mr-3 mb-3 mb-md-0 d-flex align-items-center">
                            <i class="fa fa-truck fa-3x text-info"></i>
                            <h4 class="mb-0 ml-3 ml-md-3 font-weight-bold text-dark">DELIVERY TIME</h4>
                        </div>
                        <div class="flex-grow-1 d-none d-md-block">
                            </div>
                        <div class="d-flex flex-column flex-sm-row mt-3 mt-md-0 justify-content-end w-100 w-md-auto align-items-center">
                           <button class="btn btn-outline-secondary mr-3 px-4 py-2 rounded-pill mx-3">TODAY</button>
                            <button class="btn btn-outline-primary p-2 px-3 py-2 w-100 w-sm-auto rounded-pill d-flex align-items-center justify-content-center shadow-sm">
                                <i class="fa fa-calendar-alt mr-2 small"></i>
                                <span class="small">CHOOSE ANOTHER DAY AND TIME SLOT</span>
                            </button>
                        </div>
                    </div>
                </div>

                <hr class="my-5"/>
            </section>

            <section class="bg-white p-4 p-md-5 rounded shadow-sm Vpading">
                <div class="row mb-5">
                    <div class="col-12 text-center mb-5">
                        <h2 class="text-uppercase font-weight-bold text-dark">PICKING DATE AND DELIVERY TIME</h2>
                        <p class="text-muted">Select your preferred delivery date and time slot</p>
                    </div>
                    
                    <div class="col-12 mb-5">
                        <h5 class="mb-4 font-weight-bold text-dark">Select a delivery date <span class="text-danger">*</span></h5>
                        <div class="d-flex justify-content-between flex-wrap">
                            
                            <div class="card p-4 text-center border-primary shadow-sm mb-3 date-card active" style="width: 32%;"> 
                                <span class="font-weight-bold h5 mb-1">Today</span>
                                <span class="text-primary h6">13 August</span>
                                <small class="text-muted">Fastest delivery</small>
                            </div>

                            <div class="card p-4 text-center mb-3 date-card" style="width: 32%;">
                                <span class="font-weight-bold h5 mb-1">Tomorrow</span>
                                <span class="h6">14 August</span>
                                <small class="text-muted">Standard delivery</small>
                            </div>
                            
                            <div class="card p-4 text-center mb-3 date-card" style="width: 32%;">
                                <i class="fa fa-calendar-alt fa-2x mb-2 text-muted"></i>
                                <span class="font-weight-bold h5">Pick a date</span>
                                <small class="text-muted">Flexible scheduling</small>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-12 mb-4 mt-2">
                        <h5 class="mb-4 font-weight-bold text-dark">Select a delivery time <span class="text-danger">*</span></h5>
                        <div class="row">
                            <div class="col-6 col-md-3 p-2">
                                <div class="card p-3 text-center border time-slot">9:00am - 11:00am</div>
                            </div>
                            <div class="col-6 col-md-3 p-2">
                                <div class="card p-3 text-center border time-slot">11:00am - 1:00pm</div>
                            </div>
                            <div class="col-6 col-md-3 p-2">
                                <div class="card p-3 text-center border time-slot">1:00pm - 3:00pm</div>
                            </div>
                            <div class="col-6 col-md-3 p-2">
                                <div class="card p-3 text-center border time-slot">3:00pm - 5:00pm</div>
                            </div>
                            <div class="col-6 col-md-3 p-2">
                                <div class="card p-3 text-center border time-slot">5:00pm - 7:00pm</div>
                            </div>
                            <div class="col-6 col-md-3 p-2">
                                <div class="card p-3 text-center border time-slot">7:00pm - 9:00pm</div>
                            </div>
                            <div class="col-6 col-md-3 p-2">
                                <div class="card p-3 text-center border time-slot">9:00pm - 12:00am</div>
                            </div>
                            <div class="col-6 col-md-3 p-2">
                                <div class="card p-3 d-flex flex-column justify-content-center align-items-center bg-light border text-muted disabled-slot">
                                    <span class="font-weight-bold">90 Mins Express</span>
                                    <span class="text-danger small mt-1">Not Available</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-5 mb-3">
                    <div class="col-12 d-flex justify-content-end">
                        <button class="btn btn-outline-secondary mr-3 px-4 py-2 rounded-pill mx-3">CANCEL</button>
                        <button class="btn btn-info text-white px-4 py-2 rounded-pill">CONFIRM ORDER</button>
                    </div>
                </div>

            </section>
            
        </div>
    </t>

</templates>