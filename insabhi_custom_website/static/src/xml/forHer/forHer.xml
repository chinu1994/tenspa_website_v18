<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="insabhi_custom_website.ForHer" owl="1">
    <div class="serviceSelecting container py-5">

        <!-- HERO -->
        <section class="insabhi-hero-video position-relative" style="min-height:100vh;">
            <div class="position-absolute top-0 start-0 w-100 h-100" style="z-index:0;">
                <img src="/insabhi_custom_website/static/src/Images/treatment.jpg" alt="Ten Wellness Hero" class="w-100 h-100 object-fit-cover d-block"/>
            </div>
            <div class="insabhi-hero-overlay-bottom">
                <div class="insabhi-hero-content-bottom container">
                    <h1 class="insabhi-hero-title">Welcome To Ten Wellness</h1>
                    <h2 class="insabhi-hero-subtitle">Treatment For Him</h2>
                </div>
            </div>
        </section>

        <!-- MAIN TITLE -->
        <div class="text-center my-5 pt-5">
            <h1 class="display-5 fw-bold" style="color:#d4b08c;">Select a Category to Gift</h1>
            <p class="lead text-muted">Choose the perfect wellness experience</p>
        </div>

        <!-- CATEGORY CARDS -->
        <div class="row row-cols-2 row-cols-md-5 g-4 mb-5 justify-content-center">
            <t t-foreach="categories" t-as="cat" t-key="cat.id">
                <div class="col">
                    <div class="category-card position-relative overflow-hidden rounded-4 shadow-lg cursor-pointer"
                         t-att-class="{ 'ring-4 ring-primary ring-offset-4': state.selectedCategory === cat.id }"
                         t-on-click="() => selectCategory(cat.id)"
                         style="height: 280px; border: 4px solid transparent;">
                        <img t-att-src="cat.image" class="w-100 h-100 object-fit-cover"/>
                        <div class="position-absolute bottom-0 start-0 w-100 text-center p-4"
                             style="background: linear-gradient(transparent, rgba(0,0,0,0.85));">
                            <h5 class="text-white fw-bold fs-4 mb-0 text-shadow"><t t-esc="cat.name"/></h5>
                            <t t-if="state.selectedCategory === cat.id">
                                <div class="badge bg-primary mt-2 px-4 py-2">SELECTED</div>
                            </t>
                        </div>
                        <t t-if="state.selectedCategory === cat.id">
                            <div class="position-absolute inset-0 d-flex align-items-center justify-content-center bg-primary bg-opacity-25">
                                <i class="fa fa-check-circle fa-4x text-white"></i>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </div>

        <!-- SERVICES -->
        <t t-if="state.selectedCategory and !state.showGiftCards and !state.showMessageForm and !state.showAddons and !state.showDeliveryForm and !state.showFinalOrder">
            <div class="text-center mb-5">
                <h2 class="display-5 fw-bold" style="color:#d4b08c;">
                    <t t-esc="categories.find(c => c.id === state.selectedCategory)?.name"/> Services
                </h2>
                <p class="lead text-muted">Choose the perfect gift for him</p>
            </div>

            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-5">
                <t t-foreach="getCurrentServices()" t-as="service" t-key="service_index">
                    <div t-att-class="state.selectedService and state.selectedService.name !== service.name ? 'd-none' : 'col'">
                        <div class="card h-100 border-0 shadow hover-effect overflow-hidden cursor-pointer"
                             t-on-click="() => selectService(service)">
                            <img t-att-src="service.img" class="card-img-top" style="height: 500px; object-fit: cover;"/>
                            <div class="card-body d-flex flex-column p-4">
                                <h5 class="card-title fw-bold text-center mb-2"><t t-esc="service.name"/></h5>
                                <t t-if="state.selectedService and state.selectedService.name === service.name">
                                    <div class="duration-inline my-4">
                                        <div class="d-flex gap-3 justify-content-center flex-wrap">
                                            <button t-on-click.stop="() => selectDuration(60, 29.5)"
                                                    t-att-class="state.selectedDuration === 60 ? 'duration-btn active' : 'duration-btn'">1 Hour</button>
                                            <button t-on-click.stop="() => selectDuration(90, 42.0)"
                                                    t-att-class="state.selectedDuration === 90 ? 'duration-btn active' : 'duration-btn'">1.5 Hours</button>
                                            <button t-on-click.stop="() => selectDuration(120, 52.0)"
                                                    t-att-class="state.selectedDuration === 120 ? 'duration-btn active' : 'duration-btn'">2 Hours</button>
                                        </div>
                                    </div>
                                </t>
                                <p class="card-text text-muted small flex-grow-1 text-center"><t t-esc="service.desc || ''"/></p>
                                <button class="couture-btn empress mt-auto w-100 py-3 fw-bold">Select &amp; Gift</button>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </t>

        <!-- BLACK SUMMARY CARD -->
        <t t-if="state.selectedService and state.selectedDuration and !state.showGiftCards and !state.showMessageForm and !state.showAddons and !state.showDeliveryForm and !state.showFinalOrder">
            <div class="d-flex justify-content-center mt-5">
                <div class="service-summary-card">
                    <img t-att-src="state.selectedService.img" class="rounded-4"/>
                    <h3 class="fw-bold mt-4 text-white text-center"><t t-esc="state.selectedService.name"/></h3>
                    <div class="price-display text-center mt-3">KWD <span t-esc="state.selectedPrice"/></div>
                    <p class="text-light mt-4 opacity-75 text-center">
                        A light-pressure massage that relaxes the nerves,<br/>
                        calms the body, reduces stress, and promotes circulation.
                    </p>
                    <button class="add-to-cart-btn mt-4" t-on-click="proceedToGiftCards">ADD TO CART</button>
                </div>
            </div>
        </t>

        <!-- GIFT CARDS -->
        <t t-if="state.showGiftCards and !state.showMessageForm and !state.showAddons and !state.showDeliveryForm and !state.showFinalOrder">
            <div class="text-center my-5">
                <h2 class="display-5 fw-bold" style="color:#d4b08c;">Choose Your Gift Type</h2>
                <p class="lead text-muted">Select the perfect physical gift package</p>
            </div>
            <div class="row row-cols-1 row-cols-md-3 g-5 justify-content-center">
                <div class="col">
                    <div class="gift-card-white position-relative shadow-lg rounded-4 overflow-hidden cursor-pointer"
                         t-on-click="() => selectGiftType('diamond')">
                        <img src="/insabhi_custom_website/static/src/Images/diamond.jpg" class="w-100" style="height:580px; object-fit:cover;"/>
                        <div class="p-4 text-center bg-white">
                            <h4 class="fw-bold" style="color:#d4b08c;">Diamond Gift Voucher:</h4>
                            <p class="fw-bold fs-5">(Bamboo Plant + Luxury Bag + Invitation Card Box)<br/>Price: 26.5 KD including delivery</p>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="gift-card-white position-relative shadow-lg rounded-4 overflow-hidden cursor-pointer"
                         t-on-click="() => selectGiftType('platinum')">
                        <img src="/insabhi_custom_website/static/src/Images/platinum.jpg" class="w-100" style="height:580px; object-fit:cover;"/>
                        <div class="p-4 text-center bg-white">
                            <h4 class="fw-bold" style="color:#d4b08c;">Platinum Gift Voucher:</h4>
                            <p class="fw-bold fs-5">Luxury Gift Box + Invitation Card<br/>Price: 14.5 KD including delivery</p>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="gift-card-white position-relative shadow-lg rounded-4 overflow-hidden cursor-pointer"
                         t-on-click="() => selectGiftType('gold')">
                        <img src="/insabhi_custom_website/static/src/Images/gold.png" class="w-100" style="height:580px; object-fit:cover;"/>
                        <div class="p-4 text-center bg-white">
                            <h4 class="fw-bold" style="color:#d4b08c;">Golden Gift Voucher</h4>
                            <p class="fw-bold fs-5">Digital invitation<br/>Price: 1.5 KD (sent via WhatsApp)</p>
                        </div>
                    </div>
                </div>
            </div>
        </t>

        <!-- PERSONALIZATION FORM -->
        <t t-if="state.showMessageForm and !state.showAddons and !state.showDeliveryForm and !state.showFinalOrder">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-6 col-md-8">
                        <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background:white; border: 4px solid #d4b08c;">
                            <div class="card-body p-5">
                                <div class="text-center mb-5">
                                    <img src="/insabhi_custom_website/static/src/Images/logo1.0.png" alt="Ten" style="height: 50px; display:block; margin-left:auto; margin-right:auto;" />
                                </div>
                                <h2 class="text-center fw-bold mb-5" style="color:#d4b08c;">Personalize Your Gift</h2>

                                <div class="mb-4">
                                    <label class="form-label fw-bold text-danger">* TO:</label>
                                    <input type="text" class="form-control rounded-pill py-3 px-4 fs-5" placeholder="Recipient's name" t-model="state.recipientName"/>
                                </div>

                                <div class="mb-4 position-relative">
                                    <label class="form-label fw-bold text-danger">* WRITE A MESSAGE</label>
                                    <div class="position-relative">
                                        <textarea class="form-control rounded-3 py-4 px-4" rows="6" placeholder="Write your heartfelt message here..." maxlength="180" t-model="state.message" style="resize:none; background:#f8f9fa; font-size:1.1rem;"></textarea>
                                        <div class="position-absolute end-0 bottom-0 mb-3 me-3">
                                            <small class="text-muted me-2">Automated message</small>
                                            <select class="form-select form-select-sm d-inline-block" style="width: auto;" t-on-change="applyAutoMessage">
                                                <option value="">Select...</option>
                                                <option value="father">For Father</option>
                                                <option value="mother">For Mother</option>
                                                <option value="husband">For Husband</option>
                                                <option value="wife">For Wife</option>
                                                <option value="friend">For Friend</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="text-end text-muted small mt-2">
                                        <span t-esc="180 - (state.message ? state.message.length : 0)"/> characters left
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold">FROM:</label>
                                    <input type="text" class="form-control rounded-pill py-3 px-4 fs-5" placeholder="Your name (optional)" t-model="state.senderName"/>
                                </div>

                                <t t-if="state.selectedGiftType === 'gold'">
                                    <div class="mb-4">
                                        <label class="form-label fw-bold">PASTE A LINK TO A SONG (Optional)</label>
                                        <input type="url" class="form-control rounded-pill py-3 px-4" placeholder="https://youtube.com/..." t-model="state.songLink"/>
                                    </div>
                                </t>

                                <div class="d-grid mt-5">
                                    <button class="btn btn-lg rounded-pill py-4 fw-bold text-white fs-4" style="background:#d4b08c;" t-on-click="completeGift">
                                        COMPLETE GIFT VOUCHER
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>

        <!-- ADD-ONS PAGE -->
        <t t-if="state.showAddons and !state.showDeliveryForm and !state.showFinalOrder">
            <div class="container py-5 text-center">

                <!-- Prestige Drive Video -->
                <div class="row justify-content-center mb-5">
                    <div class="col-lg-5 col-md-7 col-10 mx-auto">
                        <div >
                            <video
                                class="reel-video w-100"
                                style="width:300px; height:600px;"
                                loop="loop"
                                autoplay="autoplay"
                                playsinline="playsinline"
                                muted="muted"
                                preload="auto"
                                controls="controls"
                            >
                                <source src="/insabhi_custom_website/static/src/Images/prestige.mp4" type="video/mp4"/>
                            </video>

                        </div>
                    </div>
                </div>

                <!-- Prestige Drive Text + ADD Button -->
                <div class="mb-5">
                    <h3 class="fw-bold" style="color:#d4b08c;">Prestige drive service:</h3>
                    <p class="lead text-muted">
                        a premium transportation service offering round-trip rides<br/>
                        to and from your home using the latest luxury cars<br/>
                        <strong>Price: 24 kwd</strong>
                    </p>
                    <button class="btn btn-dark rounded-pill px-5" t-on-click="showDelivery">ADD</button>
                </div>

                <!-- Perfume Title -->
                <h3 class="fw-bold mb-4" style="color:#d4b08c;">Ten Wellness perfumes</h3>

                <!-- 4 Perfume Cards -->
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 justify-content-center">
                    <div class="col">
                        <div class="text-center bg-dark text-white p-4 rounded-4 shadow">
                            <img src="/insabhi_custom_website/static/src/Images/prop7.jpg" class="img-fluid rounded mb-3" style="height:260px; object-fit:cover; margin:3px auto"/>
                            <h5>29.7 KWD</h5>
                            <p>PERFUME 2, 100 ML</p>
                            <button class="btn btn-light rounded-pill px-5" t-on-click="showDelivery">ADD</button>
                        </div>
                    </div>
                    <div class="col">
                        <div class="text-center bg-dark text-white p-4 rounded-4 shadow">
                            <img src="/insabhi_custom_website/static/src/Images/tenStoreProducate5.jpg" class="img-fluid rounded mb-3" style="height:260px; object-fit:cover; margin:3px auto"/>
                            <h5>29.7 KWD</h5>
                            <p>PERFUME 1, 100 ML</p>
                            <button class="btn btn-light rounded-pill px-5" t-on-click="showDelivery">ADD</button>
                        </div>
                    </div>
                    <div class="col">
                        <div class="text-center bg-dark text-white p-4 rounded-4 shadow">
                            <img src="/insabhi_custom_website/static/src/Images/tenStoreProducat6.jpg" class="img-fluid rounded mb-3" style="height:260px; object-fit:cover; margin:3px auto"/>
                            <h5>29.7 KWD</h5>
                            <p>PERFUME 3, 100 ML</p>
                            <button class="btn btn-light rounded-pill px-5" t-on-click="showDelivery">ADD</button>
                        </div>
                    </div>
                    <div class="col">
                        <div class="text-center bg-dark text-white p-4 rounded-4 shadow">
                            <img src="/insabhi_custom_website/static/src/Images/tenbottle2.jpg" class="img-fluid rounded mb-3" style="height:260px; object-fit:cover; margin:3px auto"/>
                            <h5>11 KWD</h5>
                            <p>TEN BOTTLE</p>
                            <button class="btn btn-light rounded-pill px-5" t-on-click="showDelivery">ADD</button>
                        </div>
                    </div>
                </div>
            </div>
        </t>

        <!-- DELIVERY FORM + DATE/TIME PICKER -->
        <t t-if="state.showDeliveryForm and !state.showFinalOrder">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-6 col-md-8">

                        <!-- SHIPPING METHOD CARD -->
                        <t t-if="!state.showDateTimePicker">
                            <div class="bg-black text-white rounded-4 shadow-lg p-5" style="border-radius: 24px;">
                                <div class="text-center mb-4">
                                    <h4 class="mb-3">Shipping method</h4>
                                    <button class="btn btn-outline-light rounded-pill px-5 py-2 me-3">Standard</button>
                                    <button class="btn btn-success rounded-pill px-4 py-2">FREE</button>
                                </div>

                                <div class="bg-white text-dark rounded-4 p-4 mb-5">
                                    <div class="form-check form-switch d-flex align-items-center justify-content-between">
                                        <div>
                                            <h6 class="mb-1">Ask the recipient for the address</h6>
                                            <small class="text-muted">We will collect the address from the recipient. Delivery time may be impacted if recipient is unreachable</small>
                                        </div>
                                        <input class="form-check-input ms-4" type="checkbox" style="width:60px; height:32px;"/>
                                    </div>
                                </div>

                                <div class="text-center text-muted small mb-4">
                                    IF THIS OPTION IS TURNED ON WILL ASK FOR THE NEXT THING
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold text-uppercase">Recipient Name</label>
                                    <input type="text" class="form-control bg-dark text-white border-white rounded-pill py-3" placeholder=""/>
                                </div>

                                <div class="mb-5">
                                    <label class="form-label fw-bold text-uppercase">Recipient Phone</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-dark text-white border-white">
                                            <img src="/insabhi_custom_website/static/src/Images/kw-flag.png" width="20" class="me-2"/> +965
                                        </span>
                                        <input type="tel" class="form-control bg-dark text-white border-white rounded-end-pill py-3" placeholder=""/>
                                    </div>
                                </div>

                                <div class="text-center">
                                    <h5 class="mb-4">
                                        <i class="fa fa-truck me-2"></i> DELIVERY TIME
                                    </h5>
                                    <div class="d-inline-block">
                                        <button class="btn btn-outline-light rounded-pill px-5 py-3 me-3">TODAY</button>
                                        <button class="btn btn-outline-light rounded-pill px-4 py-3 me-2" style="margin-top:7px">12:00 PM - 9:00PM</button>
                                        <button class="btn btn-outline-light rounded-pill px-5 py-3" style="margin-top:7px" t-on-click="openDateTimePicker">
                                            <i class="fa fa-calendar me-2"></i> CHOOSE ANOTHER DAY AND TIME SLOT
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <!-- DATE & TIME PICKER POPUP -->
                        <t t-if="state.showDateTimePicker">
                            <div class="bg-white rounded-4 shadow-lg p-5" style="max-width: 500px; margin: 0 auto;">
                                <h4 class="text-center mb-4 fw-bold text-dark">PICKING DATE AND DELIVERY TIME</h4>
                                <div class="text-start text-muted small mb-4">Another time</div>

                                <div class="mb-4">
                                    <label class="form-label text-danger">Select a delivery date *</label>
                                    <div class="row g-3">
                                        <div class="col-4">
                                            <button class="btn btn-outline-primary w-100 rounded-3 py-3 text-center border-2">
                                                <div class="fw-bold">Today</div>
                                                <div class="small">13 August</div>
                                            </button>
                                        </div>
                                        <div class="col-4">
                                            <button class="btn btn-outline-secondary w-100 rounded-3 py-3 text-center">
                                                <div class="fw-bold">Tomorrow</div>
                                                <div class="small">14 August</div>
                                            </button>
                                        </div>
                                        <div class="col-4">
                                            <button class="btn btn-outline-secondary w-100 rounded-3 py-3 text-center d-flex align-items-center justify-content-center gap-2">
                                                <i class="fa fa-calendar"></i>
                                                <span>Pick a date</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-5">
                                    <label class="form-label text-danger">Select a delivery time *</label>
                                    <div class="row g-3">
                                        <div class="col-6"><button class="btn btn-outline-secondary w-100 rounded-3 py-3">9:00am - 11:00am</button></div>
                                        <div class="col-6"><button class="btn btn-outline-secondary w-100 rounded-3 py-3">11:00am - 1:00pm</button></div>
                                        <div class="col-6"><button class="btn btn-outline-secondary w-100 rounded-3 py-3">1:00pm - 3:00pm</button></div>
                                        <div class="col-6"><button class="btn btn-outline-secondary w-100 rounded-3 py-3">3:00pm - 5:00pm</button></div>
                                        <div class="col-6"><button class="btn btn-outline-secondary w-100 rounded-3 py-3">5:00pm - 7:00pm</button></div>
                                        <div class="col-6"><button class="btn btn-outline-secondary w-100 rounded-3 py-3">7:00pm - 9:00pm</button></div>
                                        <div class="col-6"><button class="btn btn-outline-secondary w-100 rounded-3 py-3">9:00am - 12:00am</button></div>
                                        <div class="col-6"><button class="btn btn-outline-secondary w-100 rounded-3 py-3">90 Mins Express</button></div>
                                        <div class="col-12"><button class="btn btn-outline-danger w-100 rounded-3 py-3 text-danger">Not Available</button></div>
                                    </div>
                                </div>

                                <div class="text-end">
                                    <button class="btn btn-outline-secondary rounded-pill px-4 py-2 me-2" t-on-click="closeDateTimePicker">CANCEL</button>
                                    <button class="btn btn-info text-white rounded-pill px-4 py-2" t-on-click="confirmDateTime">CONFIRM</button>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </div>
        </t>

        <!-- FINAL ORDER SUMMARY – EXACTLY LIKE YOUR IMAGE -->
        <t t-if="state.showFinalOrder">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-10">
                        <div class="row g-4">
                            <!-- Left Side -->
                            <div class="col-md-6">
                                <div class="bg-light rounded-4 p-5 text-center mb-4">
                                    <h4 class="text-uppercase text-muted mb-4">YOUSEF</h4>
                                    <div class="bg-secondary text-white rounded-4 py-5 px-4 mb-4">
                                        <h5 class="mb-0">ENJOY YOUR TREATMENT,<br/>YOU DESERVE IT.</h5>
                                    </div>
                                    <h4 class="text-uppercase text-muted">AHMED</h4>
                                </div>

                                <div class="bg-dark text-white rounded-4 p-4">
                                    <small class="text-muted d-block mb-3">Title on email</small>
                                    <p class="mb-4">Email me with news and offers</p>

                                    <div class="mb-3">
                                        <label class="form-label small text-uppercase">Delivery</label>
                                        <select class="form-select bg-dark text-white border-secondary"><option>Kuwait</option></select>
                                    </div>

                                    <div class="row g-2 mb-3">
                                        <div class="col-6"><input type="text" class="form-control bg-dark text-white border-white" placeholder="First name"/></div>
                                        <div class="col-6"><input type="text" class="form-control bg-dark text-white border-whiter" placeholder="Last name"/></div>
                                    </div>

                                    <input type="text" class="form-control bg-dark text-white border-white mb-2" placeholder="Address - Area, Block, St, Bldg, Floor, Apartment"/>
                                    <input type="text" class="form-control bg-dark text-white border-white mb-2" placeholder="Enter an address"/>
                                    <input type="text" class="form-control bg-dark text-white border-white mb-2" placeholder="Postal code (optional)"/>
                                    <input type="text" class="form-control bg-dark text-white border-white mb-3" placeholder="City"/>

                                    <select class="form-select bg-dark text-white border-white mb-3"><option>Al Farwaniyah</option></select>

                                    <input type="text" class="form-control bg-dark text-white border-white mb-4" placeholder="Phone"/>

                                    <div class="form-check text-white small mb-3">
                                        <input class="form-check-input" type="checkbox" id="saveInfo"/>
                                        <label class="form-check-label" for="saveInfo">Save this information for next time</label>
                                    </div>

                                    <div class="d-flex justify-content-between text-white small">
                                        <span>Shipping method</span>
                                        <span>Standard <strong>FREE</strong></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Right Side -->
                            <div class="col-md-6">
                                <div class="bg-dark text-white rounded-4 p-4">
                                    <div class="d-flex align-items-center mb-3">
                                        <span class="badge bg-secondary rounded-circle me-3">1</span>
                                        <div class="flex-grow-1"><strong>Snake Plant</strong></div>
                                        <strong>KWD 9.000</strong>
                                    </div>
                                    <div class="d-flex align-items-center mb-4">
                                        <span class="badge bg-secondary rounded-circle me-3">2</span>
                                        <div class="flex-grow-1"><strong>Ten Bottle Matt Olive</strong></div>
                                        <strong>KWD 23.800</strong>
                                    </div>

                                    <div class="border-top border-secondary pt-3">
