<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="insabhi_custom_website.ForHer" owl="1">
    <div class="serviceSelecting container py-5">

        <!-- HERO -->
        <section class="insabhi-hero-video position-relative" style="min-height:100vh;">
            <div class="position-absolute top-0 start-0 w-100 h-100" style="z-index:0;">

             <img src="/insabhi_custom_website/static/src/Images/herBanner.jpg" alt="Ten Wellness Hero" class="w-100 h-100 object-fit-cover d-block"/>
            </div>
            <div class="insabhi-hero-overlay-bottom">
                <div class="insabhi-hero-content-bottom container">
                    <h1 class="insabhi-hero-title">Welcome To Ten Wellness</h1>
                    <h2 class="insabhi-hero-subtitle">Treatment For Her</h2>
                </div>
            </div>
        </section>

        <!-- MAIN TITLE -->
        <div class="text-center my-5 pt-5">
            <h1 class="display-5 fw-bold" style="color:#d4b08c;">Select a Category to Gift</h1>
            <p class="lead text-muted">Choose the perfect wellness experience</p>
        </div>

        <!-- CATEGORY CARDS -->
        <div class="row row-cols-2 row-cols-md-5 g-4 mb-5 justify-content-center">
            <t t-foreach="categories" t-as="cat" t-key="cat.id">
                <div class="col">
                    <div class="category-card position-relative overflow-hidden rounded-4 shadow-lg cursor-pointer"
                         t-att-class="{ 'ring-4 ring-primary ring-offset-4': state.selectedCategory === cat.id }"
                         t-on-click="() => selectCategory(cat.id)"
                         style="height: 280px; border: 4px solid transparent;">
                        <img t-att-src="cat.image" class="w-100 h-100 object-fit-cover"/>
                        <div class="position-absolute bottom-0 start-0 w-100 text-center p-4"
                             style="background: linear-gradient(transparent, rgba(0,0,0,0.85));">
                            <h5 class="text-white fw-bold fs-4 mb-0 text-shadow"><t t-esc="cat.name"/></h5>
                            <t t-if="state.selectedCategory === cat.id">
                                <div class="badge bg-primary mt-2 px-4 py-2">SELECTED</div>
                            </t>
                        </div>
                        <t t-if="state.selectedCategory === cat.id">
                            <div class="position-absolute inset-0 d-flex align-items-center justify-content-center bg-primary bg-opacity-25">
                                <i class="fa fa-check-circle fa-4x text-white"></i>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </div>

        <!-- SERVICES -->
        <t t-if="state.selectedCategory and !state.showGiftCards and !state.showMessageForm and !state.showAddons">
            <div class="text-center mb-5">
                <h2 class="display-5 fw-bold" style="color:#d4b08c;">
                    <t t-esc="categories.find(c => c.id === state.selectedCategory)?.name"/> Services
                </h2>
                <p class="lead text-muted">Choose the perfect gift for him</p>
            </div>

            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-5">
                <t t-foreach="getCurrentServices()" t-as="service" t-key="service_index">
                    <div t-att-class="state.selectedService and state.selectedService.name !== service.name ? 'd-none' : 'col'">
                        <div class="card h-100 border-0 shadow hover-effect overflow-hidden cursor-pointer"
                             t-on-click="() => selectService(service)">
                            <img t-att-src="service.img" class="card-img-top" style="height: 500px; object-fit: cover;"/>
                            <div class="card-body d-flex flex-column p-4">
                                <h5 class="card-title fw-bold text-center mb-2"><t t-esc="service.name"/></h5>
                                <t t-if="state.selectedService and state.selectedService.name === service.name">
                                    <div class="duration-inline my-4">
                                        <div class="d-flex gap-3 justify-content-center flex-wrap">
                                            <button t-on-click.stop="() => selectDuration(60, 29.5)"
                                                    t-att-class="state.selectedDuration === 60 ? 'duration-btn active' : 'duration-btn'">1 Hour</button>
                                            <button t-on-click.stop="() => selectDuration(90, 42.0)"
                                                    t-att-class="state.selectedDuration === 90 ? 'duration-btn active' : 'duration-btn'">1.5 Hours</button>
                                            <button t-on-click.stop="() => selectDuration(120, 52.0)"
                                                    t-att-class="state.selectedDuration === 120 ? 'duration-btn active' : 'duration-btn'">2 Hours</button>
                                        </div>
                                    </div>
                                </t>
                                <p class="card-text text-muted small flex-grow-1 text-center"><t t-esc="service.desc || ''"/></p>
                                <button class="couture-btn empress mt-auto w-100 py-3 fw-bold">Select &amp; Gift</button>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </t>

        <!-- BLACK SUMMARY CARD -->
        <t t-if="state.selectedService and state.selectedDuration and !state.showGiftCards and !state.showMessageForm and !state.showAddons">
            <div class="d-flex justify-content-center mt-5">
                <div class="service-summary-card">
                    <img t-att-src="state.selectedService.img" class="rounded-4"/>
                    <h3 class="fw-bold mt-4 text-white text-center"><t t-esc="state.selectedService.name"/></h3>
                    <div class="price-display text-center mt-3">KWD <span t-esc="state.selectedPrice"/></div>
                    <p class="text-light mt-4 opacity-75 text-center">
                        A light-pressure massage that relaxes the nerves,<br/>
                        calms the body, reduces stress, and promotes circulation.
                    </p>
                    <button class="add-to-cart-btn mt-4" t-on-click="proceedToGiftCards">ADD TO CART</button>
                </div>
            </div>
        </t>

        <!-- GIFT CARDS -->
        <t t-if="state.showGiftCards and !state.showMessageForm and !state.showAddons">
            <div class="text-center my-5">
                <h2 class="display-5 fw-bold" style="color:#d4b08c;">Choose Your Gift Type</h2>
                <p class="lead text-muted">Select the perfect physical gift package</p>
            </div>
            <div class="row row-cols-1 row-cols-md-3 g-5 justify-content-center">
                <!-- Diamond, Platinum, Gold — unchanged -->
                <div class="col">
                    <div class="gift-card-white position-relative shadow-lg rounded-4 overflow-hidden cursor-pointer"
                         t-on-click="() => selectGiftType('diamond')">
                        <img src="/insabhi_custom_website/static/src/Images/diamond.jpg" class="w-100" style="height:580px; object-fit:cover;"/>
                        <div class="p-4 text-center bg-white">
                            <h4 class="fw-bold" style="color:#d4b08c;">Diamond Gift Voucher:</h4>
                            <p class="fw-bold fs-5">(Bamboo Plant + Luxury Bag + Invitation Card Box)<br/>Price: 26.5 KD including delivery</p>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="gift-card-white position-relative shadow-lg rounded-4 overflow-hidden cursor-pointer"
                         t-on-click="() => selectGiftType('platinum')">
                        <img src="/insabhi_custom_website/static/src/Images/platinum.jpg" class="w-100" style="height:580px; object-fit:cover;"/>
                        <div class="p-4 text-center bg-white">
                            <h4 class="fw-bold" style="color:#d4b08c;">Platinum Gift Voucher:</h4>
                            <p class="fw-bold fs-5">Luxury Gift Box + Invitation Card<br/>Price: 14.5 KD including delivery</p>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="gift-card-white position-relative shadow-lg rounded-4 overflow-hidden cursor-pointer"
                         t-on-click="() => selectGiftType('gold')">
                        <img src="/insabhi_custom_website/static/src/Images/gold.png" class="w-100" style="height:580px; object-fit:cover;"/>
                        <div class="p-4 text-center bg-white">
                            <h4 class="fw-bold" style="color:#d4b08c;">Golden Gift Voucher</h4>
                            <p class="fw-bold fs-5">Digital invitation<br/>Price: 1.5 KD (sent via WhatsApp)</p>
                        </div>
                    </div>
                </div>
            </div>
        </t>

        <!-- PERSONALIZATION FORM -->
        <t t-if="state.showMessageForm and !state.showAddons">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-6 col-md-8">
                        <div class="card border-0 shadow-lg rounded-4 overflow-hidden" style="background:white; border: 4px solid #d4b08c;">
                            <div class="card-body p-5">
                                <div class="text-center mb-5">
                                    <img src="/insabhi_custom_website/static/src/Images/logo1.0.png" alt="Ten" style="height: 50px; display:block; margin-left:auto; margin-right:auto;" />
                                </div>
                                <h2 class="text-center fw-bold mb-5" style="color:#d4b08c;">Personalize Your Gift</h2>

                                <div class="mb-4">
                                    <label class="form-label fw-bold text-danger">* TO:</label>
                                    <input type="text" class="form-control rounded-pill py-3 px-4 fs-5" placeholder="Recipient's name" t-model="state.recipientName"/>
                                </div>

                                <div class="mb-4 position-relative">
                                    <label class="form-label fw-bold text-danger">* WRITE A MESSAGE</label>
                                    <div class="position-relative">
                                        <textarea class="form-control rounded-3 py-4 px-4" rows="6" placeholder="Write your heartfelt message here..." maxlength="180" t-model="state.message" style="resize:none; background:#f8f9fa; font-size:1.1rem;"></textarea>
                                        <div class="position-absolute end-0 bottom-0 mb-3 me-3">
                                            <small class="text-muted me-2">Automated message</small>
                                            <select class="form-select form-select-sm d-inline-block" style="width: auto;" t-on-change="applyAutoMessage">
                                                <option value="">Select...</option>
                                                <option value="father">For Father</option>
                                                <option value="mother">For Mother</option>
                                                <option value="husband">For Husband</option>
                                                <option value="wife">For Wife</option>
                                                <option value="friend">For Friend</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="text-end text-muted small mt-2">
                                        <span t-esc="180 - (state.message ? state.message.length : 0)"/> characters left
                                    </div>
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-bold">FROM:</label>
                                    <input type="text" class="form-control rounded-pill py-3 px-4 fs-5" placeholder="Your name (optional)" t-model="state.senderName"/>
                                </div>

                                <t t-if="state.selectedGiftType === 'gold'">
                                    <div class="mb-4">
                                        <label class="form-label fw-bold">PASTE A LINK TO A SONG (Optional)</label>
                                        <input type="url" class="form-control rounded-pill py-3 px-4" placeholder="https://youtube.com/..." t-model="state.songLink"/>
                                    </div>
                                </t>

                                <div class="d-grid mt-5">
                                    <button class="btn btn-lg rounded-pill py-4 fw-bold text-white fs-4" style="background:#d4b08c;" t-on-click="completeGift">
                                        COMPLETE GIFT VOUCHER
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>

        <!-- ADD-ONS PAGE – ONLY VIDEO + TEXT + 4 PERFUMES -->
        <t t-if="state.showAddons">
            <div class="container py-5 text-center">

                <!-- Prestige Drive Video (Reels Size) -->
               <div class="row justify-content-center mb-5">
                    <div class="col-lg-5 col-md-7 col-10 mx-auto">
                        <div >
                            <video
                                class="reel-video w-100"
                                style="width:300px; height:600px;"
                                loop="loop"
                                autoplay="autoplay"
                                playsinline="playsinline"
                                muted="muted"
                                preload="auto"
                                controls="controls"
                            >
                                <source src="/insabhi_custom_website/static/src/Images/prestige.mp4" type="video/mp4"/>
                            </video>

                        </div>
                    </div>
                </div>
                <!-- Prestige Drive Text (Only English) -->
                <div class="mb-5">
                    <h3 class="fw-bold" style="color:#d4b08c;">Prestige drive service:</h3>
                    <p class="lead text-muted">
                        a premium transportation service offering round-trip rides<br/>
                        to and from your home using the latest luxury cars<br/>
                        <strong>Price: 24 kwd / Price with tabby: 26 kwd</strong>
                    </p>
                </div>

                <!-- Perfume Title -->
                <h3 class="fw-bold mb-4" style="color:#d4b08c;">Ten Wellness perfumes</h3>

                <!-- 4 Perfume Cards -->
<!--                <div class="row row-cols-2 row-cols-md-4 g-4 justify-content-center">-->
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 justify-content-center">
                    <div class="col">
                        <div class="text-center bg-dark text-white p-4 rounded-4 shadow">
                            <img src="/insabhi_custom_website/static/src/Images/prop7.jpg" class="img-fluid rounded mb-3" style="height:260px; object-fit:cover; margin: 3px auto;"/>
                            <h5>29.7 KWD</h5>
                            <p>PERFUME 2, 100 ML</p>
                            <button class="btn btn-light rounded-pill px-5">ADD</button>
                        </div>
                    </div>
                    <div class="col">
                        <div class="text-center bg-dark text-white p-4 rounded-4 shadow">
                            <img src="/insabhi_custom_website/static/src/Images/tenStoreProducate5.jpg" class="img-fluid rounded mb-3" style="height:260px; object-fit:cover; margin: 3px auto;"/>
                            <h5>29.7 KWD</h5>
                            <p>PERFUME 1, 100 ML</p>
                            <button class="btn btn-light rounded-pill px-5">ADD</button>
                        </div>
                    </div>
                    <div class="col">
                        <div class="text-center bg-dark text-white p-4 rounded-4 shadow">
                            <img src="/insabhi_custom_website/static/src/Images/tenStoreProducat6.jpg" class="img-fluid rounded mb-3" style="height:260px; object-fit:cover; margin: 3px auto;"/>
                            <h5>29.7 KWD</h5>
                            <p>PERFUME 3, 100 ML</p>
                            <button class="btn btn-light rounded-pill px-5">ADD</button>
                        </div>
                    </div>
                    <div class="col">
                        <div class="text-center bg-dark text-white p-4 rounded-4 shadow">
                            <img src="/insabhi_custom_website/static/src/Images/tenbottle2.jpg" class="img-fluid rounded mb-3" style="height:260px; object-fit:cover; margin: 3px auto;"/>
                            <h5>11 KWD</h5>
                            <p>TEN BOTTLE</p>
                            <button class="btn btn-light rounded-pill px-5">ADD</button>
                        </div>
                    </div>
                </div>

            </div>
        </t>

        <!-- EMPTY STATE -->
        <t t-if="!state.selectedCategory">
            <div class="text-center py-5 my-5">
                <i class="fa fa-hand-point-up fa-4x text-muted mb-4"></i>
                <p class="lead text-muted fs-3">Please select a category above</p>
            </div>
        </t>

        <!-- WHATSAPP -->
        <a href="https://api.whatsapp.com/send?phone=96522288282" class="position-fixed bg-success text-white rounded-circle shadow-lg d-flex align-items-center justify-content-center whatsapp-fixed-btn"
           style="width:60px;height:60px;bottom:1.5rem;right:1.5rem;z-index:1000;" target="_blank" rel="noopener noreferrer">
            <i class="bi bi-whatsapp" style="font-size:1.8rem;"></i>
        </a>
    </div>

    <!-- STYLES (unchanged) -->
    <style>
        .hover-effect:hover { transform: translateY(-12px) scale(1.02); box-shadow: 0 20px 40px rgba(0,0,0,0.22) !important; }
        .category-card:hover img { transform: scale(1.12); transition: 0.6s; }
        .text-shadow { text-shadow: 2px 2px 10px rgba(0,0,0,0.9); }

        .duration-btn { background: transparent; border: 2px solid #999; color: #555; padding: 10px 28px; border-radius: 50px; font-weight: 600; min-width: 110px; transition: all 0.3s ease; }
        .duration-btn.active, .duration-btn:hover { background: #d4b08c !important; color: white !important; border-color: #d4b08c !important; }

        .service-summary-card { background: #000; border-radius: 24px; padding: 2rem; color: white; max-width: 420px; margin: 40px auto; text-align: center; box-shadow: 0 20px 40px rgba(0,0,0,0.4); }
        .service-summary-card img { width: 100%; height: 280px; object-fit: cover; border-radius: 20px; }
        .price-display { font-size: 2.8rem; font-weight: 800; color: #d4b08c; margin: 1rem 0; }
        .add-to-cart-btn { background: transparent; border: 2px solid white; color: white; padding: 14px 40px; border-radius: 8px; font-size: 1.1rem; font-weight: 700; transition: 0.3s; width: 220px; margin: 20px auto 0; display: block; }
        .add-to-cart-btn:hover { background: white; color: black; }

        .gift-card-white:hover { transform: translateY(-15px); box-shadow: 0 25px 50px rgba(0,0,0,0.2); }
        .form-control { border: 2px solid #e9ecef; background: #f8f9fa; }
        .form-control:focus { border-color: #d4b08c; box-shadow: 0 0 0 0.25rem rgba(212,176,140,0.25); }
    </style>
</t>
</templates>