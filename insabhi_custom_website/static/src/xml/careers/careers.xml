<t t-name="insabhi_custom_website.Careers" owl="1">
    <div class="careers-page">

        <!-- HERO – FULL TEAM IMAGE + CENTERED TEXT + FADE-IN ANIMATION (same as homepage) -->
         <section class="insabhi-hero-video position-relative" style="min-height:100vh;">
            <div class="position-absolute top-0 start-0 w-100 h-100" style="z-index:0;">
                <img src="/insabhi_custom_website/static/src/Images/team.png"
                     alt="Ten Wellness Hero"
                     class="w-100 h-100 object-fit-cover d-block"/>
            </div>
            <div class="insabhi-hero-overlay-bottom">
                <div class="insabhi-hero-content-bottom container">
                    <h1 class="insabhi-hero-title">Careers at Ten Wellness</h1>
                </div>
            </div>
        </section>


        <!-- WHY JOIN US – LUXURIOUS TEXT SECTION (English only) -->
        <section class="py-5" style="background:#f8f6f3;">
            <div class="container py-5">
                <div class="row justify-content-center">
                    <div class="col-lg-10 col-xl-9 text-center">

                        <h2 class="display-5 fw-light mb-5" style="font-family:'Playfair Display',serif; color:#2d2a26;">
                            Why Join Us?
                        </h2>

                        <div class="w-120px h-1 bg-gold mx-auto mb-5" style="background:#d4b08c;"></div>

                        <div class="luxury-prose" style="font-size:1.25rem; line-height:2; color:#444; max-width:960px; margin:0 auto;">
                            <p class="mb-5">
                                At the heart of our work is <strong>integrity and entrepreneurship</strong>. What matters most is the willingness to do whatever it takes to deliver top-quality results, together as a team.
                            </p>
                            <p class="mb-5">
                                Here, we’re an <strong>A-player team that’s got each other’s backs</strong>. One way we show that is through our <strong>WOW Prize</strong> — whenever you spot a teammate living one of our eight values, talk to HR and they could earn <strong>five Kuwaiti dinar</strong> and a certificate of recognition.
                            </p>
                            <p class="mb-5">
                                Growth isn’t just a buzzword; it’s real. We evaluate performance <strong>twice every 12 months</strong> to spot and grow those who work hard, show heart, and drive Ten forward.
                            </p>
                            <p class="mb-5">
                                To succeed, focus on integrity and knowledge — invest in yourself with reading and courses, because <strong>when you grow, we invest in you too</strong>.
                            </p>
                            <p class="mb-5">
                                We want you to come to work <strong>excited</strong>, to have fun with your teammates, to find meaning, and to see your skills and opportunities expand year after year.
                            </p>
                            <p class="lead fst-italic mt-5" style="color:#d4b08c; font-size:1.7rem;">
                                That’s what being part of this team is all about.
                            </p>
                        </div>

                        <!-- APPLY BUTTON (link can be added later) -->
                        <div class="mt-5 pt-4">
                            <a href="#" class="btn btn-outline-dark rounded-pill px-5 py-3 text-uppercase fw-medium border-2"
                               style="letter-spacing:3px; font-size:0.95rem;">
                                View Open Positions
                                <i class="bi bi-arrow-right ms-3"></i>
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </section>

    </div>
