<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="insabhi_custom_website.Careers" owl="1">
        <div class="careers">
            <div class="o_careers_page_content">

                <section class="careers-hero-section d-flex flex-column"
                         style="background-image: url('/insabhi_custom_website/static/src/image/about1.png'); background-size: cover; background-position: center; min-height: 500px;">
                    <div class="container h-100">
                        <div class="row align-items-center h-100">
                            <div class="col-lg-6 careers-hero-content p-5">
                                <h2 class="career">Career opportunities</h2>
                                <p>Ten workplaces are distinguished by a rare blend of courtesy, cordiality and
                                    intellectual energy. We seek skilled individuals who can bring a wealth of
                                    perspectives and inspired ideas to our table.
                                </p>
                                <a href="#" class="btn btn-light custom-hover-effect mt-4"
                                   style="font-size: 14px; padding: 10px 20px;">
                                       Browse all openings →
                                </a>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="careers-main-content py-5 p-3">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-4">
                                <h3 class="careers-section-title">Our values</h3>
                            </div>
                            <div class="col-lg-8">
                                <ul class="careers-value-list">
                                    <t t-set="values"
                                       t-value="['Respect', 'Creativity', 'Excellence', 'Passion', 'Integrity']"/>
                                    <t t-foreach="values" t-as="value" t-key="value_index">
                                        <li class="careers-value-item" data-bs-toggle="collapse"
                                            t-att-data-bs-target="'#valueCollapse_' + value_index">
                                            <span t-esc="value"/>
                                            <i class="oi oi-arrow-down"/> </li>
                                    </t>
                                </ul>
                            </div>
                        </div>

                        <hr class="my-5"/>
                        <div class="row pt-5">
                            <div class="col-lg-4">
                                <h3 class="careers-section-title">Our commitment</h3>
                            </div>
                            <div class="col-lg-8">
                                <p class="careers-text-content">We dedicate ourselves fervently to humble but significant philanthropic endeavours,
                                    and our approach is best described by the adage ‘actions speak louder than words’-Team Ten.
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="careers-people-section py-5 p-3">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-4">
                                <h3 class="careers-section-title">Our people</h3>
                            </div>
                            <div class="col-lg-8">
                                <p class="careers-text-content mb-4">Our people play an integral role in our continued success. We support
                                    and encourage our employees’ endeavours to learn and grow, whether working towards
                                    the mastery of a specialist skill, building experience that will enable them to
                                    apply to an aspirational role, or strengthening their portable life skills.
                                </p>
                                <p class="careers-text-content mb-4">We take a holistic approach to ensure genuine wellbeing and psychological safety by focusing on
                                    supporting professional, physical, financial and emotional wellbeing. All employees around the global
                                    also have access to a local wellbeing provider through our employee assistance program.
                                </p>
                                <p class="careers-text-content mb-5">We are also on a mission to unlock opportunities for people from all backgrounds, and have groups and
                                    communities that champion women and allies, LGBTQIA+ individuals, neurodiversity, race, ethnicity
                                    and culture.
                                </p>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="insabhi-fullvideo-section position-relative" style="min-height:60vh;">
                    <img src="/insabhi_custom_website/static/src/image/team.png" alt="Full section background"
                         class="w-100 h-100 object-fit-cover position-absolute top-0 start-0"
                         style="z-index:-1;"/>
